              },
              "severity": {
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "critical",
                  "unknown",
                  null
                ]
              },
              "cve_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
