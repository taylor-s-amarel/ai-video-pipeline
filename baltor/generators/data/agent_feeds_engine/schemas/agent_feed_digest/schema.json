  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/agent-feed-digest",
  "title": "Agent feed digest",
  "description": "What changed since a cursor for one project, grouped by the action needed (breaking, deprecation, security, new capability, FYI), newest first inside each group, each entry with reasons and a suggested action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "project",
    "generated",
    "since_cursor",
    "next_cursor",
    "counts",
    "groups"
  ],
