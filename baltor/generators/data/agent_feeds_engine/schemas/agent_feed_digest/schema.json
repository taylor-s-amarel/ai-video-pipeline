    "spec": {
      "const": "baltor.agent-feed-digest/v1"
    },
    "project": {
      "type": "string"
    },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "since_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "watchlist": {
      "type": "string",
      "description": "Path or sha256 of the watchlist used"
    },
    "min_score": {
      "type": "integer"
