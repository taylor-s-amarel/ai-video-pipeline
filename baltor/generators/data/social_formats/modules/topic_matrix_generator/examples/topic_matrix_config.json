{
  "niches": [
    {"id": "space", "label": "Space", "subjects": ["Olympus Mons", "Europa", "the Voyager probes", "a neutron star"], "risk": []},
    {"id": "history", "label": "History", "subjects": ["the Panama Canal", "the printing press", "Roman roads"], "risk": []},
    {"id": "animals", "label": "Animals", "subjects": ["the octopus", "the blue whale", "the tardigrade"], "risk": []},
    {"id": "money", "label": "Money basics", "subjects": ["compound interest", "a credit score", "inflation"], "risk": ["regulated-finance"], "exclude_formats": ["what-if-scenario"]}
  ],
  "angles": [
    {"id": "scale", "template": "the true size of {subject}", "formats": ["size-scale-comparison", "versus-comparison"]},
    {"id": "origin", "template": "where {subject} came from", "formats": ["timeline-evolution", "history-explainer"]},
    {"id": "myth", "template": "the biggest myth about {subject}", "formats": ["myth-vs-fact"]},
    {"id": "inside", "template": "what happens inside {subject}", "formats": ["how-it-works-cutaway"]},
    {"id": "what-if", "template": "what if {subject} disappeared", "formats": ["what-if-scenario"], "niches": ["space", "animals"]}
  ],
  "formats": [
    {"id": "size-scale-comparison", "label": "Size and scale comparison", "durations": [60, 90]},
    {"id": "versus-comparison", "label": "This vs that", "durations": [60]},
    {"id": "timeline-evolution", "label": "Timeline", "durations": [60, 90]},
    {"id": "history-explainer", "label": "History explainer", "durations": [60, 90]},
    {"id": "myth-vs-fact", "label": "Myth vs fact", "durations": [30, 60]},
    {"id": "how-it-works-cutaway", "label": "How it works", "durations": [60]},
    {"id": "what-if-scenario", "label": "What if", "durations": [60, 90]}
  ],
  "hooks": [
    {"id": "really", "template": "How big is {subject}, really?", "formats": ["size-scale-comparison", "versus-comparison"], "angles": ["scale"]},
    {"id": "nobody", "template": "Nobody explains {angle}", "formats": ["*"]},
    {"id": "question", "template": "Why does everyone get {subject} wrong?", "formats": ["myth-vs-fact"]},
    {"id": "what-if", "template": "What if {subject} vanished tomorrow?", "formats": ["what-if-scenario"]},
    {"id": "then-now", "template": "{subject}: before and after", "formats": ["timeline-evolution", "history-explainer"]}
  ],
  "weights": {"specificity": 1.0, "curiosity": 1.0, "format_fit": 1.0, "novelty": 1.0, "risk": 1.0},
  "limits": {"max_per_format": 3, "max_per_niche": 4, "max_per_subject": 1, "max_per_hook": 4},
  "dedupe_threshold": 0.8
}
