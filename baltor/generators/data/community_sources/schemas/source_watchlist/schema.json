{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/source-watchlist",
  "title": "Source watchlist",
  "description": "What an agent monitors and how politely: Baltor feed collections or individual feed URLs, weighted keywords, exclusions, digest grouping and polling limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "cadence",
    "sources",
    "keywords",
    "polite"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,60}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string"
    },
    "cadence": {
      "enum": [
        "hourly",
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "window": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?[dh]$",
      "description": "Look-back window for a digest run, e.g. 7d."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "collection"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ],
        "properties": {
          "collection": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,60}$",
            "description": "A Baltor feed collection id (feeds/<id>.json)."
          },
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Limit a collection to these item ids."
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 2
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 2
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        ]
      }
    },
    "exclude_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "match"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "tags_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "feed_url_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "terms_any": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "max_items_per_source": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "recency_half_life_days": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "trend_min_sources": {
      "type": "integer",
      "minimum": 2,
      "description": "A rising term is reported only when at least this many different feeds mention it."
    },
    "polite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_agent",
        "min_interval_s",
        "max_polls_per_day"
      ],
      "properties": {
        "user_agent": {
          "type": "string",
          "minLength": 10,
          "pattern": "(https?://|@)",
          "description": "Must name the tool and give a contact URL or address."
        },
        "min_interval_s": {
          "type": "number",
          "minimum": 1,
          "description": "Minimum seconds between requests to one host."
        },
        "max_polls_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96,
          "description": "Per feed."
        },
        "respect_retry_after": {
          "type": "boolean",
          "default": true
        },
        "conditional_get": {
          "type": "boolean",
          "default": true
        },
        "host_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 1
          },
          "description": "Per-host minimum interval in seconds."
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "markdown": {
          "type": "string"
        },
        "json": {
          "type": "string"
        }
      }
    },
    "cautions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
