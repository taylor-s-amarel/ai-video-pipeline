{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/showcase-comparison",
  "title": "Showcase comparison",
  "description": "Baseline arm versus Baltor arm for one pre-registered task: per-metric samples, means, difference with bootstrap CI, win rate, Cliff's delta, Holm-adjusted permutation p-values, verdicts, success rates, cost deltas, catalogue use and disclosures. Produced by the showcase_stats code module; differences are mean(baltor) - mean(baseline); effect sizes and win rates are oriented so positive favours the Baltor arm.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "task_id", "title", "domain", "purpose", "task_type", "negative_control", "spec_sha256",
               "generated_at", "generator", "design", "runs", "runs_excluded", "metrics", "success", "cost",
               "catalogue_use", "multiple_comparisons", "verdict_rules", "overall", "harness_versions", "models",
               "adapters", "disclosures"],
  "$defs": {
    "num": {"type": ["number", "null"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "mean", "median", "sd", "min", "max"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "mean": {"$ref": "#/$defs/num"}, "median": {"$ref": "#/$defs/num"}, "sd": {"$ref": "#/$defs/num"},
        "min": {"$ref": "#/$defs/num"}, "max": {"$ref": "#/$defs/num"},
        "samples": {"type": "array", "items": {"$ref": "#/$defs/num"}},
        "run_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "ci_low", "ci_high", "ci_level"],
      "properties": {
        "estimate": {"$ref": "#/$defs/num"}, "ci_low": {"$ref": "#/$defs/num"}, "ci_high": {"$ref": "#/$defs/num"},
        "ci_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "verdict": {"enum": ["baltor-better", "baseline-better", "no-clear-difference", "insufficient-data"]},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "direction", "weight", "primary", "derived", "baseline", "baltor", "difference",
                   "win_rate", "effect_size", "p_value", "p_holm", "verdict", "evidence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
        "kind": {"enum": ["deterministic", "llm-judge", "human-judge", "self-reported", "derived"]},
        "direction": {"enum": ["higher", "lower"]},
        "weight": {"type": "number", "minimum": 0},
        "primary": {"type": "boolean"},
        "derived": {"type": "boolean"},
        "minimum_effect": {"$ref": "#/$defs/num"},
        "baseline": {"$ref": "#/$defs/summary"},
        "baltor": {"$ref": "#/$defs/summary"},
        "difference": {"$ref": "#/$defs/difference"},
        "win_rate": {
          "type": "object", "additionalProperties": false,
          "required": ["baltor_wins", "baseline_wins", "ties", "pairs", "rate"],
          "properties": {
            "baltor_wins": {"type": "integer", "minimum": 0}, "baseline_wins": {"type": "integer", "minimum": 0},
            "ties": {"type": "integer", "minimum": 0}, "pairs": {"type": "integer", "minimum": 0},
            "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        },
        "effect_size": {
          "type": "object", "additionalProperties": false, "required": ["name", "value", "magnitude"],
          "properties": {
            "name": {"const": "cliffs_delta"},
            "value": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
            "magnitude": {"enum": ["negligible", "small", "medium", "large", null]},
            "orientation": {"type": "string"}
          }
        },
        "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "p_holm": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "permutation": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {"method": {"enum": ["exact", "monte-carlo"]}, "permutations": {"type": "integer"}}
        },
        "verdict": {"$ref": "#/$defs/verdict"},
        "evidence": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  },
  "properties": {
    "spec": {"const": "baltor.showcase-comparison/v1"},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "title": {"type": "string", "minLength": 3},
    "domain": {"type": "string"},
    "purpose": {"enum": ["study", "pilot", "dry-run"]},
    "task_type": {"enum": ["capability", "knowledge-access"]},
    "negative_control": {"type": "boolean"},
    "spec_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "generator": {"type": "object", "required": ["module", "version"],
                  "properties": {"module": {"type": "string"}, "version": {"type": "string"}}},
    "design": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis", "trials_planned", "alpha", "ci_level", "bootstrap_resamples", "seed", "ci_method", "test",
                   "min_achievable_p"],
      "properties": {
        "analysis": {"enum": ["paired", "unpaired"]},
        "trials_planned": {"type": "integer", "minimum": 3},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.2},
        "ci_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrap_resamples": {"type": "integer", "minimum": 1000},
        "seed": {"type": "integer"},
        "ci_method": {"type": "string"},
        "test": {"type": "string"},
        "min_achievable_p": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "runs": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "baltor"],
      "properties": {
        "baseline": {"type": "object", "required": ["included"], "properties": {"included": {"type": "array", "items": {"type": "string"}}}},
        "baltor": {"type": "object", "required": ["included"], "properties": {"included": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "runs_excluded": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["run_id", "reason"],
                "properties": {"run_id": {"type": "string"}, "reason": {"type": "string", "minLength": 3}}}
    },
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["threshold", "baseline", "baltor", "difference", "p_value"],
      "properties": {
        "threshold": {"type": ["object", "null"]},
        "baseline": {"type": "object", "required": ["successes", "n", "rate"]},
        "baltor": {"type": "object", "required": ["successes", "n", "rate"]},
        "difference": {"$ref": "#/$defs/difference"},
        "p_value": {"type": ["number", "null"]}
      }
    },
    "cost": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "label", "direction", "missing_values", "baseline", "baltor", "difference", "relative_difference"],
        "properties": {
          "name": {"enum": ["wall_s", "tool_calls", "tokens_total", "cost_usd"]},
          "label": {"type": "string"},
          "direction": {"const": "lower"},
          "missing_values": {"type": "integer", "minimum": 0},
          "baseline": {"$ref": "#/$defs/summary"},
          "baltor": {"$ref": "#/$defs/summary"},
          "difference": {"$ref": "#/$defs/difference"},
          "relative_difference": {"$ref": "#/$defs/num"}
        }
      }
    },
    "catalogue_use": {
      "type": "object", "additionalProperties": false,
      "required": ["baltor_runs", "baltor_runs_with_catalogue_calls", "identities", "expected_components", "expected_components_found"],
      "properties": {
        "baltor_runs": {"type": "integer", "minimum": 0},
        "baltor_runs_with_catalogue_calls": {"type": "integer", "minimum": 0},
        "identities": {"type": "array", "items": {"type": "object", "required": ["identity", "runs"]}},
        "expected_components": {"type": "array", "items": {"type": "string"}},
        "expected_components_found": {"type": "array", "items": {"type": "string"}}
      }
    },
    "multiple_comparisons": {
      "type": "object", "required": ["method", "family", "note"],
      "properties": {"method": {"const": "holm"}, "family": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}
    },
    "verdict_rules": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "overall": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_metric", "verdict", "negative_control_status", "warnings"],
      "properties": {
        "primary_metric": {"type": ["string", "null"]},
        "verdict": {"$ref": "#/$defs/verdict"},
        "negative_control_status": {"enum": ["passed", "failed", "baltor-hurt", "inconclusive", null]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "harness_versions": {"type": "object"},
    "models": {"type": "object"},
    "adapters": {"type": "array", "items": {"type": ["string", "null"]}},
    "disclosures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
  }
}
