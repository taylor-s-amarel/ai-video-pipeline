{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/showcase-task-spec",
  "title": "Showcase task spec (pre-registered)",
  "description": "One pre-registered comparison task: the same prompt, inputs, budget and evaluators for a baseline arm (harness + model alone) and a Baltor arm (same harness + model plus catalogue access). A registered spec carries spec_sha256 (SHA-256 of the canonical JSON of every other field) and files_sha256 (every file in the task directory), and every run record repeats spec_sha256. Cross-field fairness rules that JSON Schema cannot express (identical harness, model, tools and flags in both arms; no catalogue hints in the prompt; exactly one primary metric) are checked by showcase_runner lint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "id", "version", "purpose", "task_type", "domain", "title", "prompt", "inputs", "outputs", "budget",
               "over_budget", "arms", "metrics", "success_threshold", "trials", "order", "negative_control", "analysis",
               "disclosures", "preregistered_on", "files_sha256", "spec_sha256"],
  "$defs": {
    "relpath": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"},
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
    "catalogue_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "search-read", "mcp", "preplaced"],
                 "description": "none: no catalogue. search-read: a logged `baltor search|read|place` command on PATH. mcp: logged intelligence_search / provisioning_read tools over MCP. preplaced: the listed identities are placed before the agent starts (only when the task's arm definition says so)."},
        "identities": {"type": "array", "items": {"$ref": "#/$defs/identity"}, "uniqueItems": true},
        "endpoint": {"type": "string", "description": "Optional: 'local' (this repository's catalogue through the logged gateway, default) or an MCP URL such as https://baltor.ai/mcp"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "preplaced"}}, "required": ["mode"]},
         "then": {"required": ["identities"], "properties": {"identities": {"minItems": 1}}},
         "else": {"not": {"required": ["identities"]}}}
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "harness_version", "model", "allowed_tools", "catalogue_access", "prompt_addendum"],
      "properties": {
        "harness": {"enum": ["claude-code", "codex", "opencode", "command", "manual"]},
        "harness_version": {"type": "string", "minLength": 1, "maxLength": 60,
                            "description": "Exact version string, or a prefix such as '2.1.' that the detected version must start with."},
        "model": {"type": "string", "minLength": 1, "maxLength": 120},
        "allowed_tools": {"type": "array", "items": {"type": "string", "maxLength": 200}, "uniqueItems": true,
                          "description": "Identical in both arms. The runner adds only the catalogue tools to the Baltor arm."},
        "extra_args": {"type": "array", "items": {"type": "string", "maxLength": 300}},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"},
                    "description": "For harness 'command': argv template with {prompt_file}, {workspace}, {model} placeholders."},
        "transcript_format": {"enum": ["stream-json", "codex-json", "opencode-json", "text"]},
        "isolation": {"enum": ["none", "home"], "description": "home: HOME and XDG_CONFIG_HOME point at an empty per-trial directory so user-level skills, agents and MCP servers cannot leak in."},
        "catalogue_access": {"$ref": "#/$defs/catalogue_access"},
        "prompt_addendum": {"type": "string", "maxLength": 1200,
                            "description": "Appended to the shared prompt for this arm only. Describes access mechanics, never task hints."}
      },
      "allOf": [
        {"if": {"properties": {"harness": {"const": "command"}}, "required": ["harness"]}, "then": {"required": ["command"]}}
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "kind", "evaluator", "weight", "on_missing"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$", "not": {"const": "weighted_score"}},
        "description": {"type": "string", "maxLength": 500},
        "direction": {"enum": ["higher", "lower"]},
        "kind": {"enum": ["deterministic", "llm-judge", "human-judge", "self-reported"]},
        "evaluator": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$",
                     "description": "Name in the showcase_evaluators registry, e.g. pytest, f1_ground_truth, sklearn_metric, image_checks, mp4_checks, gltf_checks, json_schema, citations, metric_from_file, script, files_present, blind_judge."},
            "params": {"type": "object"}
          }
        },
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "primary": {"type": "boolean"},
        "on_missing": {"type": "number", "description": "Score given when the run produced nothing evaluable or failed. Failures are scored, never dropped."},
        "range": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
        "minimum_effect": {"type": "number", "minimum": 0, "description": "Smallest favourable difference (metric units) worth reporting as an improvement."}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "licence", "path_in_workspace"],
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 120},
        "source": {"enum": ["synthetic", "sklearn-bundled", "task-dir", "url", "kaggle"]},
        "url": {"type": "string", "format": "uri"},
        "licence": {"type": "string", "minLength": 2, "maxLength": 200},
        "path_in_workspace": {"$ref": "#/$defs/relpath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requires_account": {"type": "boolean"},
        "requires_rule_acceptance": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 1000}
      },
      "allOf": [
        {"if": {"properties": {"source": {"enum": ["url", "kaggle"]}}, "required": ["source"]}, "then": {"required": ["url"]}},
        {"if": {"properties": {"source": {"const": "kaggle"}}, "required": ["source"]},
         "then": {"required": ["requires_account", "requires_rule_acceptance"],
                  "properties": {"requires_account": {"const": true}, "requires_rule_acceptance": {"const": true}}}}
      ]
    }
  },
  "properties": {
    "spec": {"const": "baltor.showcase-task/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "purpose": {"enum": ["study", "pilot", "dry-run"],
                "description": "Only 'study' results may be published as results. 'pilot' tunes budgets; 'dry-run' exercises the pipeline with fabricated or scripted outputs."},
    "task_type": {"enum": ["capability", "knowledge-access"],
                  "description": "knowledge-access: the prompt cannot be satisfied without information that only the catalogue holds. Report it as a retrieval test, never as general capability."},
    "domain": {"enum": ["kaggle-ml", "media-design", "3d-design", "video-generation", "game-development", "coding",
                        "research-citations", "data-cleaning", "cad", "home-automation", "marketing-measurement",
                        "security", "other"]},
    "title": {"type": "string", "minLength": 5, "maxLength": 140},
    "prompt": {"type": "string", "minLength": 20, "maxLength": 20000},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "setup": {
      "type": "object", "additionalProperties": false, "required": ["script"],
      "properties": {
        "script": {"$ref": "#/$defs/relpath", "description": "Task-dir script, run once per registered spec as: python3 SCRIPT --workspace DIR --private DIR --seed N"},
        "network": {"type": "boolean"},
        "hosts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "secrets": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400}
      },
      "allOf": [{"if": {"properties": {"network": {"const": true}}, "required": ["network"]},
                 "then": {"required": ["hosts"], "properties": {"hosts": {"minItems": 1}}}}]
    },
    "outputs": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "required"],
                "properties": {"path": {"$ref": "#/$defs/relpath"}, "required": {"type": "boolean"},
                               "description": {"type": "string", "maxLength": 300}}}
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["wall_s", "tool_calls", "tokens"],
      "properties": {
        "wall_s": {"type": "integer", "minimum": 10, "maximum": 172800},
        "tool_calls": {"type": "integer", "minimum": 1, "maximum": 100000},
        "tokens": {"type": "integer", "minimum": 1000, "maximum": 1000000000},
        "usd": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "over_budget": {"enum": ["score-as-failure", "evaluate-as-is"]},
    "arms": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "baltor"],
      "properties": {
        "baseline": {"allOf": [{"$ref": "#/$defs/arm"},
                               {"properties": {"catalogue_access": {"properties": {"mode": {"const": "none"}}}}}]},
        "baltor": {"allOf": [{"$ref": "#/$defs/arm"},
                             {"properties": {"catalogue_access": {"properties": {"mode": {"enum": ["search-read", "mcp", "preplaced"]}}}}}]}
      }
    },
    "shared_mcp_servers": {"type": "object", "description": "MCP servers given to BOTH arms (e.g. a Blender MCP). Must not point at a Baltor catalogue."},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "success_threshold": {
      "type": "object", "additionalProperties": false, "required": ["metric", "op", "value"],
      "properties": {"metric": {"type": "string"}, "op": {"enum": [">=", ">", "<=", "<"]}, "value": {"type": "number"}}
    },
    "trials": {"type": "integer", "minimum": 3, "maximum": 50},
    "order": {"enum": ["alternate", "randomised"],
              "description": "alternate: ABBA blocks (counterbalanced against drift); randomised: seeded shuffle within each trial pair."},
    "negative_control": {"type": "boolean"},
    "negative_control_rationale": {"type": "string", "minLength": 20, "maxLength": 1000},
    "expected_components": {"type": "array", "items": {"$ref": "#/$defs/identity"}, "uniqueItems": true,
                            "description": "Analysis only: components the designers expect to help. Never shown to an agent."},
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["design", "bootstrap_resamples", "ci_level", "seed", "alpha"],
      "properties": {
        "design": {"enum": ["unpaired", "paired"]},
        "bootstrap_resamples": {"type": "integer", "minimum": 2000, "maximum": 200000},
        "ci_level": {"type": "number", "minimum": 0.8, "maximum": 0.99},
        "seed": {"type": "integer", "minimum": 0},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.2}
      }
    },
    "pricing": {
      "type": "object", "additionalProperties": false, "required": ["input_per_mtok", "output_per_mtok", "currency", "as_of"],
      "properties": {
        "input_per_mtok": {"type": "number", "minimum": 0}, "output_per_mtok": {"type": "number", "minimum": 0},
        "cache_read_per_mtok": {"type": "number", "minimum": 0}, "currency": {"const": "USD"},
        "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "source": {"type": "string"}
      }
    },
    "disclosures": {
      "type": "object", "additionalProperties": false, "required": ["conflict_of_interest"],
      "properties": {"conflict_of_interest": {"type": "string", "minLength": 20},
                     "other": {"type": "array", "items": {"type": "string", "minLength": 10}}}
    },
    "preregistered_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "registered_by": {"type": "string", "maxLength": 120},
    "files_sha256": {"type": "object", "propertyNames": {"$ref": "#/$defs/relpath"},
                     "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notes": {"type": "string", "maxLength": 4000}
  },
  "allOf": [
    {"if": {"properties": {"negative_control": {"const": true}}, "required": ["negative_control"]},
     "then": {"required": ["negative_control_rationale"]}}
  ]
}
