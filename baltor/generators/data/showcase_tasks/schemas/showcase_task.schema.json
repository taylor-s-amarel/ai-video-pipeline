{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/schemas/showcase-task",
  "title": "Baltor showcase task (task.json)",
  "description": "One pre-registered task for a with/without-Baltor comparison. Everything that can change an outcome (prompt, inputs, budget, metrics, evaluator and setup file hashes, trials, pass rule, arms, analysis) is inside the spec hash; only spec_hash and preregistration are outside it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "task_id", "slug", "title", "version", "domain", "category", "negative_control", "summary",
               "prompt", "requirements", "deliverables", "inputs", "setup", "evaluator", "metrics", "success",
               "budget", "arms", "trials", "analysis", "hypothesis", "judging", "expected_components",
               "expected_capabilities", "cost_metrics", "requires_kaggle_account", "cautions", "disclosures",
               "params", "spec_hash", "preregistration"],
  "properties": {
    "spec": {"const": "baltor.showcase-task/v1"},
    "task_id": {"type": "string", "pattern": "^showcase_task_[a-z0-9]+(_[a-z0-9]+)*$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "domain": {"enum": ["kaggle-ml", "media-design", "3d-design", "video-generation", "game-development", "coding",
                        "research", "data-cleaning", "cad", "home-automation", "marketing-measurement", "security",
                        "negative-control"]},
    "category": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "negative_control": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 240},
    "prompt": {"type": "string", "minLength": 20},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "workspace_rules": {"type": "array", "items": {"type": "string"}},
    "deliverables": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "description"],
      "properties": {"path": {"type": "string"}, "description": {"type": "string"}}}},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace_files", "hidden_files", "network", "data_sources"],
      "properties": {
        "workspace_files": {"type": "array", "items": {"type": "string"}},
        "hidden_files": {"type": "array", "items": {"type": "string"}},
        "network": {"enum": ["none", "catalogue-only"]},
        "data_sources": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "kind", "licence", "redistributed"],
          "properties": {
            "name": {"type": "string"},
            "kind": {"enum": ["synthetic", "bundled-with-library", "kaggle-competition", "fixture"]},
            "licence": {"type": "string"},
            "url": {"type": "string", "format": "uri"},
            "redistributed": {"type": "boolean", "description": "true only when bytes of a third-party dataset are copied into the package; always false here"},
            "notes": {"type": "string"}}}}}},
    "setup": {"$ref": "#/$defs/program"},
    "evaluator": {
      "allOf": [{"$ref": "#/$defs/program"}],
      "properties": {
        "entry": true, "files": true, "command": true,
        "deterministic": {"type": "boolean"},
        "runs_agent_code": {"type": "boolean"},
        "external_tools": {"type": "array", "items": {"type": "string"}},
        "timeout_s": {"type": "integer", "minimum": 10}},
      "required": ["deterministic", "runs_agent_code", "external_tools", "timeout_s"],
      "unevaluatedProperties": false},
    "metrics": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "direction", "weight", "scale", "gate"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string"},
        "direction": {"enum": ["maximize", "minimize"]},
        "weight": {"type": "number", "minimum": 0},
        "scale": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2,
                  "description": "[worst, best]; normalised = clip((value - worst) / (best - worst), 0, 1)"},
        "threshold": {"type": "number"},
        "gate": {"type": "boolean"}},
      "if": {"properties": {"gate": {"const": true}}}, "then": {"required": ["threshold"]}}},
    "success": {
      "type": "object", "additionalProperties": false, "required": ["rule", "min_score", "required_checks"],
      "properties": {"rule": {"type": "string"}, "min_score": {"type": "number", "minimum": 0, "maximum": 1},
                     "required_checks": {"type": "array", "items": {"type": "string"}}}},
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["preset", "wall_time_s", "tool_calls", "tokens"],
      "properties": {"preset": {"type": "string"}, "wall_time_s": {"type": "integer", "minimum": 60},
                     "tool_calls": {"type": "integer", "minimum": 5}, "tokens": {"type": "integer", "minimum": 10000}}},
    "arms": {"type": "object", "required": ["baseline", "treatment", "held_constant"]},
    "trials": {
      "type": "object", "additionalProperties": false,
      "required": ["per_arm", "minimum_per_arm", "order", "fixture_seed"],
      "properties": {"per_arm": {"type": "integer", "minimum": 3, "maximum": 20},
                     "minimum_per_arm": {"const": 3},
                     "order": {"type": "string"}, "fixture_seed": {"type": "string"}}},
    "analysis": {"type": "object", "required": ["unit", "primary_outcome", "primary_effect", "secondary", "report_all_runs"]},
    "hypothesis": {
      "type": "object", "additionalProperties": false, "required": ["expected_effect", "rationale"],
      "properties": {"expected_effect": {"enum": ["positive", "none", "uncertain"]},
                     "rationale": {"type": "string", "minLength": 20}}},
    "judging": {
      "type": "object", "additionalProperties": false, "required": ["primary", "pairwise"],
      "properties": {
        "primary": {"const": "deterministic-evaluator"},
        "pairwise": {"oneOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false,
          "required": ["blind", "order", "criteria", "judges", "evidence_weight"],
          "properties": {"blind": {"const": true}, "order": {"const": "randomised"},
                         "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                         "judges": {"type": "array", "items": {"enum": ["human", "llm"]}},
                         "evidence_weight": {"const": "secondary"}}}]}}},
    "expected_components": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
                            "description": "Catalogue identities the authors expect could help. Post-hoc analysis only; nothing is pre-placed."},
    "expected_capabilities": {"type": "array", "items": {"type": "string"}},
    "cost_metrics": {"type": "array", "items": {"type": "string"}},
    "requires_kaggle_account": {"type": "boolean"},
    "competition": {
      "type": "object", "additionalProperties": false, "required": ["slug", "url", "rules_url", "metric"],
      "properties": {"slug": {"type": "string"}, "url": {"type": "string", "format": "uri"},
                     "rules_url": {"type": "string", "format": "uri"}, "metric": {"type": "string"},
                     "download": {"type": "string"}}},
    "cautions": {"type": "array", "items": {"type": "string"}},
    "disclosures": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "params": {"type": "object"},
    "spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preregistration": {
      "type": "object", "additionalProperties": false, "required": ["date", "revision", "ledger", "hash_method"],
      "properties": {"date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                     "revision": {"type": "integer", "minimum": 1},
                     "ledger": {"const": "showcase_preregistration_ledger"},
                     "hash_method": {"type": "string"}}}
  },
  "$defs": {
    "program": {
      "type": "object",
      "required": ["entry", "files", "command"],
      "properties": {
        "entry": {"type": "string"},
        "command": {"type": "string"},
        "files": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      }
    }
  }
}
