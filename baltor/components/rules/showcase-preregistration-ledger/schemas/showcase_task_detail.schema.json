{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/schemas/showcase-task-detail",
  "title": "Baltor showcase task detail (task_detail.json)",
  "description": "The scoring and fixture detail that sits next to a showcase task's task.json (showcase_task_spec contract). setup/make_fixtures.py and evaluate.py read it; task.json lists its SHA-256 in files_sha256, so spec_sha256 covers it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "task_id", "slug", "title", "domain", "category", "negative_control", "summary", "tests", "prompt",
               "requirements", "workspace_rules", "deliverables", "workspace_files", "private_files", "budget", "params",
               "metrics", "success", "hypothesis", "pairwise", "expected_capabilities", "cautions", "external_tools",
               "evaluator_timeout_s", "runs_agent_code", "deterministic", "catalogue_exclusions", "analysis", "fixture_seeds"],
  "properties": {
    "spec": {"const": "baltor.showcase-task-detail/v1"},
    "task_id": {"type": "string", "pattern": "^showcase_task_[a-z0-9]+(_[a-z0-9]+)*$", "maxLength": 64},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "domain": {"enum": ["kaggle-ml", "media-design", "3d-design", "video-generation", "game-development", "coding",
                        "research-citations", "data-cleaning", "cad", "home-automation", "marketing-measurement",
                        "security", "other"]},
    "category": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "negative_control": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 240},
    "tests": {"type": "string", "minLength": 10},
    "prompt": {"type": "string", "minLength": 20, "not": {"pattern": "(?i)baltor|catalogue|catalog"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "workspace_rules": {"type": "array", "items": {"type": "string"}},
    "deliverables": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "description"],
      "properties": {"path": {"type": "string", "minLength": 1}, "description": {"type": "string"}}}},
    "workspace_files": {"type": "array", "items": {"type": "string"}},
    "private_files": {"type": "array", "items": {"type": "string"}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["preset", "wall_s", "tool_calls", "tokens"],
               "properties": {"preset": {"enum": ["xs", "s", "m", "l", "xl"]}, "wall_s": {"type": "integer"},
                              "tool_calls": {"type": "integer"}, "tokens": {"type": "integer"}}},
    "params": {"type": "object"},
    "metrics": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "direction", "weight", "scale", "gate"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$", "not": {"enum": ["task_pass", "composite_score", "weighted_score"]}},
        "description": {"type": "string"},
        "direction": {"enum": ["maximize", "minimize"]},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "scale": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2,
                  "description": "[worst, best]; normalised = clip((value - worst) / (best - worst), 0, 1)"},
        "threshold": {"type": "number"},
        "gate": {"type": "boolean"}},
      "if": {"properties": {"gate": {"const": true}}}, "then": {"required": ["threshold"]}}},
    "success": {"type": "object", "additionalProperties": false, "required": ["rule", "min_score", "required_checks"],
                "properties": {"rule": {"type": "string"}, "min_score": {"type": "number", "minimum": 0, "maximum": 1},
                               "required_checks": {"type": "array", "items": {"type": "string"}}}},
    "hypothesis": {"type": "object", "additionalProperties": false, "required": ["expected_effect", "rationale"],
                   "properties": {"expected_effect": {"enum": ["positive", "none", "uncertain"]},
                                  "rationale": {"type": "string", "minLength": 20}}},
    "pairwise": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["criteria", "judges", "blind", "order", "scale", "evidence_weight"],
      "properties": {"criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                     "judges": {"type": "array", "items": {"enum": ["human", "llm"]}},
                     "blind": {"const": true}, "order": {"const": "randomised"},
                     "scale": {"type": "array", "items": {"type": "number"}}, "evidence_weight": {"const": "secondary"}}}]},
    "expected_capabilities": {"type": "array", "items": {"type": "string"}},
    "cautions": {"type": "array", "items": {"type": "string"}},
    "external_tools": {"type": "array", "items": {"type": "string"}},
    "evaluator_timeout_s": {"type": "integer", "minimum": 10},
    "runs_agent_code": {"type": "boolean"},
    "deterministic": {"type": "boolean"},
    "catalogue_exclusions": {"type": "object"},
    "analysis": {"type": "object"},
    "fixture_seeds": {"type": "string"},
    "competition": {"type": "object", "additionalProperties": false, "required": ["slug", "url", "rules_url", "metric"],
                    "properties": {"slug": {"type": "string"}, "url": {"type": "string", "format": "uri"},
                                   "rules_url": {"type": "string", "format": "uri"}, "metric": {"type": "string"}}}
  }
}
