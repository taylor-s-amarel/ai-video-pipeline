{
  "id": "EDU096",
  "title": "The Search Result Wears a Sponsor Badge",
  "family": "learning",
  "category": "consumer digital literacy",
  "premise": "A reader wants to understand why a result appears, but treats an advertisement and an unpaid result as identical evidence of quality. Revealing placement labels separates the source of visibility from evaluating the underlying claim.",
  "hook": "Did this position come from relevance, payment, or something else?",
  "visible_action": "Two result cards gain placement labels; claim evidence is inspected on a separate track from screen position.",
  "intended_takeaway_or_theme": "Placement and sponsorship are context, not proof that a claim is true or false.",
  "gate": "Use generic mockups; verify current labels on any named platform and avoid implying sponsorship means deception.",
