{
  "id": "ENT084",
  "title": "The Soundtrack Before the Footstep",
  "family": "fiction",
  "category": "creative-work struggles",
  "premise": "A filmmaker wants an impressive soundtrack but keeps adding epic music to a scene where the character only takes one ordinary step. They mute the score, refine the footstep timing, and bring back one perfectly timed tiny percussion hit that makes the simple action funny.",
  "hook": "The music is saving the world. He is crossing a rug.",
  "visible_action": "Orchestra symbols flood the frame; figure takes a tiny step; volume sliders drop; heel lands with one small sound mark.",
  "intended_takeaway_or_theme": "Match emphasis to what the scene actually does.",
  "gate": "Use original audio; the payoff is an editorial choice rather than a claim about universally effective comedy.",
  "evidence_class": "fictional_demonstration",
