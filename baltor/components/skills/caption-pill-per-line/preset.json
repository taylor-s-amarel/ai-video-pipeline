{
  "type": "caption-style",
  "id": "caption_pill_per_line",
  "name": "Rounded pill captions",
  "version": 1,
  "house": false,
  "font": {
    "family": "Fredoka",
    "weight": 700,
    "licence": "OFL-1.1",
    "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/fredoka/Fredoka%5Bwdth%2Cwght%5D.ttf",
    "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/fredoka/OFL.txt",
    "specimen_url": "https://fonts.google.com/specimen/Fredoka",
    "size_px": 58,
    "min_size_px": 46,
    "case": "as-written",
    "avg_char_em": 0.44,
    "variable_axes": {
      "wdth": [
        75.0,
        125.0
      ],
      "wght": [
        300.0,
        700.0
      ]
    }
  },
  "fill": "#FFFFFF",
  "stroke": {
    "color": "#1E1230",
    "width_px": 0
  },
  "backing": {
    "type": "pill",
    "tint": "#1E1230",
    "opacity": 0.7,
    "blur_px": 12,
    "radius_px": 999,
    "padding_px": [
      18,
      40
    ],
    "feather_px": 6
  },
  "layout": {
    "center_y_fraction": 0.762,
    "max_width_fraction": 0.86,
    "max_lines": 1,
    "max_words": 6,
    "max_chars": 33,
    "align": "center"
  },
  "emphasis": {
    "mode": "color",
    "scale_peak": 1.06,
    "duration_ms": 160,
    "easing": "ease-out",
    "color": "#FFB4B4"
  },
  "timing": {
    "sync_tolerance_ms": 150,
    "min_on_screen_ms": 700,
    "max_on_screen_ms": 3000
  },
  "animation_in": "text_anim_springy_pop_overshoot",
  "palette": "palette_sunset_coral",
  "contrast": {
    "text": {
      "basis": "panel-worst-case",
      "fg": "#FFFFFF",
      "bg": "#1E1230",
      "opacity": 0.7,
      "ratio": 6.62,
      "required": 3.0,
      "size_px": 46,
      "weight": 700,
      "level": "AAA"
    },
    "keyword": {
      "basis": "panel-worst-case",
      "fg": "#FFB4B4",
      "bg": "#1E1230",
      "opacity": 0.7,
      "ratio": 3.92,
      "required": 3.0,
      "size_px": 46,
      "weight": 700,
      "level": "AA"
    }
  },
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "reference_size": [
    1080,
    1920
  ],
  "use_when": [
    "Friendly topics: relationships, pets, lifestyle",
    "Rounded typefaces"
  ],
  "avoid_when": [
    "Serious news and history"
  ]
}
