  "id": "ENT086",
  "title": "The Progress Bar Painter",
  "family": "fiction",
  "category": "creative-work struggles",
  "premise": "A painter wants a progress meter for a mural, but keeps painting the meter itself until the bar reaches 100 percent beside an empty wall. They relabel it METER COMPLETE, laugh, and replace it with small checkboxes for actual mural sections, finishing one visible section before the cut.",
  "hook": "One hundred percent of what?",
  "visible_action": "Progress bar fills; camera reveals untouched wall; label changes; three task boxes appear; one section is painted and one box checked.",
  "intended_takeaway_or_theme": "Measure the work you mean to complete.",
  "gate": "Fictional workflow metaphor; no general claim that checklists guarantee project completion.",
  "evidence_class": "fictional_demonstration",
