{
  "type": "caption-style",
  "id": "caption_uppercase_impact",
  "name": "Uppercase impact (condensed)",
  "version": 1,
  "house": false,
  "font": {
    "family": "Anton",
    "weight": 400,
    "licence": "OFL-1.1",
    "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/anton/Anton-Regular.ttf",
    "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/anton/OFL.txt",
    "specimen_url": "https://fonts.google.com/specimen/Anton",
    "size_px": 84,
    "min_size_px": 64,
    "case": "upper",
    "avg_char_em": 0.419
  },
  "fill": "#FFFFFF",
  "stroke": {
    "color": "#000000",
    "width_px": 8
  },
  "backing": {
    "type": "none"
  },
  "layout": {
    "center_y_fraction": 0.763,
    "max_width_fraction": 0.84,
    "max_lines": 1,
    "max_words": 3,
    "max_chars": 25,
    "align": "center"
  },
  "emphasis": {
    "mode": "color",
    "scale_peak": 1.0,
    "duration_ms": 0,
    "easing": "linear",
    "color": "#FFCC00"
  },
  "timing": {
    "sync_tolerance_ms": 100,
    "min_on_screen_ms": 400,
    "max_on_screen_ms": 1600
  },
  "animation_in": "text_anim_kinetic_slam",
  "palette": "palette_news_contrast",
  "contrast": {
    "text": {
      "basis": "stroke",
      "fg": "#FFFFFF",
      "bg": "#000000",
      "ratio": 21.0,
      "required": 4.5,
      "size_px": 64,
      "weight": 400,
      "level": "AAA",
      "stroke_px": 8
    },
    "keyword": {
      "basis": "stroke",
      "fg": "#FFCC00",
      "bg": "#000000",
      "ratio": 13.88,
      "required": 4.5,
      "size_px": 64,
      "weight": 400,
      "level": "AAA",
      "stroke_px": 8
    }
  },
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "reference_size": [
    1080,
    1920
  ],
  "use_when": [
    "Quick-cut edits",
    "Sports",
    "countdowns and reveals"
  ],
  "avoid_when": [
    "Calm narration (three words at a time feels frantic)"
  ],
  "shadow": {
    "color": "#000000",
    "opacity": 0.55,
    "blur_px": 14,
    "offset_px": [
      0,
      6
    ]
  },
  "notes": "Anton has a single (regular) weight that is already heavy; the outline is 8 px."
}
