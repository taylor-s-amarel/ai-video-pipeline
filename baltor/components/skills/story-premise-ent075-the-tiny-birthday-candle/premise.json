  "id": "ENT075",
  "title": "The Tiny Birthday Candle",
  "family": "fiction",
  "category": "silent emotional stories",
  "premise": "A figure plans a grand birthday display but only one small candle arrives. They arrange empty chairs in disappointment, then friends enter carrying single tiny lights of their own, forming a constellation around the modest cake without changing its size.",
  "hook": "One little light is already here.",
  "visible_action": "Large empty display outline fades; one light flickers; friends place cold glowing dots around a cake; overhead view forms a constellation.",
  "intended_takeaway_or_theme": "The scale of a gathering is not the scale of its care.",
  "gate": "Use flameless fantasy lights; avoid equating social attendance with personal worth.",
  "evidence_class": "fictional_demonstration",
