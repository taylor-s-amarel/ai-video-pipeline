{
  "id": "EDU090",
  "title": "The Instruction Card Opens One Step",
  "family": "learning",
  "category": "accessibility/inclusion",
  "premise": "A participant wants to assemble a harmless paper model, but a dense paragraph buries the current action among later steps. A plain-language sequence with optional detail exposes one actionable step at a time.",
  "hook": "Which action should happen first?",
  "visible_action": "A paragraph separates into numbered action cards; an optional-detail tab expands without displacing the current step.",
  "intended_takeaway_or_theme": "Clear sequencing and optional detail can reduce unnecessary interpretation demands.",
  "gate": "Test with intended users; plain language is context-dependent and does not guarantee universal comprehension.",
  "evidence_class": "requires_primary_source_review",
