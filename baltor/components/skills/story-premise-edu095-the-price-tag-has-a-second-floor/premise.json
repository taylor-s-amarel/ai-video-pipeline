{
  "id": "EDU095",
  "title": "The Price Tag Has a Second Floor",
  "family": "learning",
  "category": "consumer digital literacy",
  "premise": "A buyer wants to compare two fictional one-time offers, but one displayed price omits a mandatory fee shown later. Expanding both into itemized totals reveals the actual arithmetic before any purchase choice.",
  "hook": "Is the smaller number also the smaller total?",
  "visible_action": "Headline prices lift like trapdoors to reveal fee blocks; full totals assemble on equal-width comparison rails.",
  "intended_takeaway_or_theme": "Compare the complete stated price and commitment, not just the headline number.",
  "gate": "Use invented amounts and explicit assumptions; do not infer current laws, taxes, refunds, or subscription terms.",
  "evidence_class": "mathematically_checkable",
