{
  "id": "EDU093",
  "title": "The Sign-In Prompt Nobody Started",
  "family": "learning",
  "category": "consumer digital literacy",
  "premise": "A user wants to respond to a sudden approval prompt, but assumes every notification means an action they initiated. A timeline checks for a matching sign-in and routes the unexplained prompt to official account guidance.",
  "hook": "Did you start the sign-in this prompt is asking about?",
  "visible_action": "A login event and approval prompt seek a matching timestamp; an unmatched prompt stops before an approval gate.",
  "intended_takeaway_or_theme": "Unexpected authentication prompts deserve verification rather than automatic approval.",
  "gate": "Follow current provider-specific guidance; no codes, recovery credentials, or bypass instructions.",
