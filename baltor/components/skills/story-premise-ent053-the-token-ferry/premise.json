{
  "id": "ENT053",
  "title": "The Token Ferry",
  "family": "fiction",
  "category": "mechanical puzzles",
  "premise": "Three round tokens need to cross a model gap in a ferry that carries at most two. A token must ride the ferry on every trip; after overfilling fails, two cross, one returns, and the last pair crosses, leaving all three at the far platform in three trips.",
  "hook": "The boat needs a passenger, even coming back.",
  "visible_action": "Two tokens board; ferry glides right; one token rides back; the remaining pair travels right; three tokens line up at the destination.",
  "intended_takeaway_or_theme": "Count the return trip as part of the plan.",
  "gate": "Verified three-trip schedule for three tokens, capacity two, and at least one rider per trip. This is a toy state puzzle, not real boating advice.",
