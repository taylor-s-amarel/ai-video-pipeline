{
  "id": "ENT017",
  "title": "The Perfect Snowman Symmetry War",
  "family": "fiction",
  "category": "two-person rivalry",
  "premise": "Two builders compete to make a toy snow figure more symmetrical, shaving away every uneven bump until the entire sculpture becomes a pebble. They stop measuring, rebuild it with deliberately mismatched arms, and discover its lopsided wave is the best part.",
  "hook": "One more correction and it will be perfect.",
  "visible_action": "Scrapers alternate; snow figure shrinks; a ruler spans the remaining pebble; fresh snow piles up with crooked twig arms.",
  "intended_takeaway_or_theme": "A pursuit of precision can erase the thing you liked.",
  "gate": "Toy snow and blunt cartoon tools; no factual claim that asymmetry is universally better.",
  "evidence_class": "fictional_demonstration",
