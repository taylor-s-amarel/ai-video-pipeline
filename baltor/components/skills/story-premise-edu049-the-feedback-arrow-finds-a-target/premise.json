{
  "id": "EDU049",
  "title": "The Feedback Arrow Finds a Target",
  "family": "learning",
  "category": "language/communication",
  "premise": "An editor wants a scene improved, but the note make it better gives the animator no usable target. Pointing to a specific confusing moment and explaining its effect creates an actionable revision request.",
  "hook": "Which moment needs to change?",
  "visible_action": "A vague cloud shrinks into an arrow on one frame, followed by observation and desired-effect cards.",
  "intended_takeaway_or_theme": "Useful feedback identifies the location, observed problem, and intended result.",
  "gate": "Keep observations separate from personal judgments; do not invent consensus about quality.",
  "evidence_class": "fictional_demonstration",
