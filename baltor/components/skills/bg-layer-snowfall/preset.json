{
  "type": "background-layer",
  "id": "bg_layer_snowfall",
  "name": "Snowfall",
  "version": 1,
  "category": "procedural-particles",
  "role": "particles",
  "look": "Three depths of snowflakes falling at different speeds.",
  "render": {
    "method": "ffmpeg-lavfi",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "loop_period_s": 8,
    "filtergraph_file": "filtergraph.txt",
    "tested_with": "FFmpeg 6.1.1",
    "colour_stops": [
      [
        0,
        "#1B2735"
      ],
      [
        90,
        "#3B5068"
      ],
      [
        200,
        "#C9D6E3"
      ],
      [
        255,
        "#FFFFFF"
      ]
    ]
  },
  "default_opacity": 0.85,
  "default_blend": "screen",
  "motion": {
    "type": "fall",
    "period_s": 8
  },
  "recolor": "ramp",
  "use_when": [
    "Winter",
    "polar and holiday topics"
  ],
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  }
}
