{
  "id": "ENT093",
  "title": "The Shopping List Origami",
  "family": "fiction",
  "category": "everyday microdramas",
  "premise": "A shopper wants to remember three ordinary items, but their overfolded paper list has hidden each word behind another crease. They unfold it into an absurdly large paper shape, copy the three items onto one small clear card, and use the original as a bag-shaped prop for the walk home.",
  "hook": "I made the list portable and the words inaccessible.",
  "visible_action": "Folded paper rotates through many shapes; three words appear separately; a plain card is written; old list folds into a decorative bag shape.",
  "intended_takeaway_or_theme": "Compression is useful only if the information stays accessible.",
  "gate": "The folded paper bag is a stylized prop, not a claim that it can safely carry groceries.",
  "evidence_class": "fictional_demonstration",
