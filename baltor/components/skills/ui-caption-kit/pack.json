{
  "spec": "baltor.media-pack/v1",
  "pack_id": "ui-caption-kit",
  "title": "UI and caption kit (fonts, panels, icons, pops)",
  "purpose": "Use when styling hook titles, one-line captions, FACT labels, lower thirds and reaction stickers for 1080x1920 shorts or Godot UI. Lists OFL fonts (Bebas Neue, Anton, Montserrat, Inter), Kenney UI Pack, Lucide/Tabler icons, Twemoji (credit) and Kenney Interface Sounds.",
  "status": "manifest-only",
  "created": "2026-10-10",
  "verified_on": "2026-10-10",
  "targets": [
    "ffmpeg-video",
    "godot-4",
    "web"
  ],
  "frame": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "licence_policy": {
    "allow_non_commercial": false,
    "allow_share_alike": false,
    "require_redistributable": false,
    "notes": "Monetised-video policy: no NC or ND assets; credit every CC-BY asset in the description."
  },
  "credits_file": "CREDITS.md",
  "notes": [
    "Manifest only: no media files are included. Fetch direct assets with the media_pack_fetcher module; open manual-page sources in a browser and record sha256 after download."
  ],
