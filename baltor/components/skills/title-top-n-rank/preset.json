{
  "type": "title-style",
  "id": "title_top_n_rank",
  "name": "Top-N rank number",
  "version": 1,
  "house": false,
  "font": {
    "family": "Anton",
    "weight": 400,
    "licence": "OFL-1.1",
    "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/anton/Anton-Regular.ttf",
    "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/anton/OFL.txt",
    "specimen_url": "https://fonts.google.com/specimen/Anton",
    "size_px": 220,
    "min_size_px": 160,
    "case": "upper",
    "avg_char_em": 0.419
  },
  "fill": "#FFCC00",
  "stroke": {
    "color": "#000000",
    "width_px": 14
  },
  "backing": {
    "type": "none"
  },
  "position": {
    "region": "upper-third",
    "center_y_fraction": 0.26,
    "over": "background",
    "max_width_fraction": 0.5
  },
  "text": {
    "template": "#{n}",
    "min_words": 1,
    "max_words": 1,
    "max_lines": 1,
    "max_chars_per_line": 5
  },
  "timing": {
    "first_frame": false,
    "hold_s": 2.0
  },
  "animation_in": "text_anim_kinetic_slam",
  "palette": "palette_news_contrast",
  "contrast": {
    "title": {
      "basis": "stroke",
      "fg": "#FFCC00",
      "bg": "#000000",
      "ratio": 13.88,
      "required": 4.5,
      "size_px": 160,
      "weight": 400,
      "level": "AAA",
      "stroke_px": 14
    },
    "secondary": {
      "basis": "stroke",
      "fg": "#FFFFFF",
      "bg": "#000000",
      "ratio": 21.0,
      "required": 3.0,
      "size_px": 56,
      "weight": 800,
      "level": "AAA",
      "stroke_px": 14
    }
  },
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "reference_size": [
    1080,
    1920
  ],
  "use_when": [
    "Countdowns and rankings"
  ],
  "avoid_when": [
    "Lists where order means nothing"
  ],
  "secondary": {
    "font": {
      "family": "Montserrat",
      "weight": 800,
      "licence": "OFL-1.1",
      "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/montserrat/Montserrat%5Bwght%5D.ttf",
      "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/montserrat/OFL.txt",
      "specimen_url": "https://fonts.google.com/specimen/Montserrat",
      "size_px": 56,
      "case": "upper",
      "avg_char_em": 0.648,
      "variable_axes": {
        "wght": [
          100.0,
          900.0
        ]
      }
    },
    "fill": "#FFFFFF",
    "gap_px": 8,
    "content": "item name"
  }
}
