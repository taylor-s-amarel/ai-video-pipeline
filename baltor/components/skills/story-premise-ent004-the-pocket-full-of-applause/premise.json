{
  "id": "ENT004",
  "title": "The Pocket Full of Applause",
  "family": "fiction",
  "category": "physical comedy",
  "premise": "A nervous speaker wants to save a little applause for later by stuffing visible clap-shaped sound marks into a pocket. The marks spring out at awkward moments until the speaker empties them into a jar, which opens during the final bow and gives one satisfyingly timed ovation.",
  "hook": "I brought my own applause. It escaped.",
  "visible_action": "Clap symbols balloon inside a pocket, pop out during sips of water, funnel into a jar, then burst upward at the bow.",
  "intended_takeaway_or_theme": "Timing can matter more than volume.",
  "gate": "Sound marks behave as magical objects; do not frame the premise as real acoustics.",
  "evidence_class": "fictional_demonstration",
