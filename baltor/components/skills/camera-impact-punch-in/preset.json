{
  "type": "camera-move",
  "id": "camera_impact_punch_in",
  "name": "Impact punch-in",
  "version": 1,
  "kind": "punch-in",
  "duration_s": 1.0,
  "zoom": {
    "from": 1.0,
    "to": 1.1
  },
  "center": {
    "from": [
      0.5,
      0.45
    ],
    "to": [
      0.5,
      0.45
    ]
  },
  "easing": "linear",
  "zoom_keyframes": [
    {
      "t": 0,
      "zoom": 1.0
    },
    {
      "t": 0.08,
      "zoom": 1.15,
      "ease": "ease-out"
    },
    {
      "t": 0.4,
      "zoom": 1.1,
      "ease": "ease-in-out"
    },
    {
      "t": 1.0,
      "zoom": 1.1
    }
  ],
  "renderer": "zoompan",
  "prescale": 4,
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "intensity": "standard",
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "use_when": [
    "Punchlines and big numbers",
    "In sync with a kick drum or keyword pop"
  ],
  "ffmpeg": {
    "filter": "scale=4320:7680:force_original_aspect_ratio=increase,crop=4320:7680,zoompan=z='if(lt((on/29),0),1,if(lt((on/29),0.08),(1+(0.15)*(1-pow(1-((((on/29))-0)/0.08),3))),if(lt((on/29),0.4),(1.15+(-0.05)*if(lt((((on/29))-0.08)/0.32,0.5),4*pow((((on/29))-0.08)/0.32,3),1-pow(-2*((((on/29))-0.08)/0.32)+2,3)/2)),if(lt((on/29),1),(1.1+(0)*((((on/29))-0.4)/0.6)),1.1))))':x='max(0,min(iw-iw/zoom,(0.5+(0)*((on/29)))*iw-iw/zoom/2))':y='max(0,min(ih-ih/zoom,(0.45+(0)*((on/29)))*ih-ih/zoom/2))':d=30:s=1080x1920:fps=30,setsar=1"
  }
}
