{
  "id": "EDU032",
  "title": "The Review Calendar Has Gaps",
  "family": "learning",
  "category": "learning/study",
  "premise": "A student needs several chances to revisit a vocabulary set, but piles every review into one afternoon. A calendar animation redistributes the same planned sessions and records what needs another look.",
  "hook": "What if the next review happened on another day?",
  "visible_action": "Equal-duration review blocks move from a crowded day into separated calendar slots; recall checks leave small flags.",
  "intended_takeaway_or_theme": "A study plan can schedule repeated reviews across time and adjust from recall.",
  "gate": "Review spacing evidence; no universally optimal interval or fixed learning outcome is claimed.",
