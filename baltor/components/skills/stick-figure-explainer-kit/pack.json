      "attribution": "Modular Characters (2D) by Kenney (kenney.nl), CC0",
      "attribution_required": false,
      "redistribution": "allowed",
      "commercial_use": "allowed",
      "format": "zip",
      "intended_use": [
        "flat explainer characters"
      ],
      "fetch": {
        "method": "manual-page",
        "status": "to-fetch"
      },
      "import_hints": {
