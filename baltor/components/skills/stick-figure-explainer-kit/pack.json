{
  "spec": "baltor.media-pack/v1",
  "pack_id": "stick-figure-explainer-kit",
  "title": "Stick-figure explainer kit (faceless 2D)",
  "purpose": "Use when building a faceless stick-figure or flat-character explainer short (1080x1920). Lists CC0/OFL/MIT sources for characters, a narrator avatar, concept icons, caption and title fonts, UI panels, particles and pop sounds, with licences and credit lines, as a manifest to fetch (no files included).",
  "status": "manifest-only",
  "created": "2026-10-10",
  "verified_on": "2026-10-10",
  "targets": [
    "ffmpeg-video",
    "godot-4"
  ],
  "frame": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "licence_policy": {
    "allow_non_commercial": false,
    "allow_share_alike": false,
    "require_redistributable": false,
    "notes": "Monetised-video policy: no NC or ND assets; credit every CC-BY asset in the description."
  },
  "credits_file": "CREDITS.md",
  "notes": [
    "Manifest only: no media files are included. Fetch direct assets with the media_pack_fetcher module; open manual-page sources in a browser and record sha256 after download."
  ],
  "assets": [
