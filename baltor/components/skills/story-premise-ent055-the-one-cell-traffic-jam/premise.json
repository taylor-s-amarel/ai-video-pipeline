  "id": "ENT055",
  "title": "The One-Cell Traffic Jam",
  "family": "fiction",
  "category": "mechanical puzzles",
  "premise": "Three labeled tiles A, B, C occupy slots 1, 2, 3 on a four-position ring with slot 4 empty. A caretaker must move A to slot 2 while retaining clockwise tile order; C slides to 4, B to 3, and A to 2, leaving the vacancy at slot 1 without any tile passing another.",
  "hook": "Nobody can pass. One space can travel.",
  "visible_action": "C slides from 3 to 4; B slides from 2 to 3; A slides from 1 to 2; the empty slot finishes at 1.",
  "intended_takeaway_or_theme": "Moving the empty space can move the whole arrangement.",
  "gate": "Use exactly the verified adjacent sequence C:3→4, B:2→3, A:1→2. The tiles preserve their cyclic order; no swapping or hidden lift is allowed.",
  "evidence_class": "mathematically_checkable",
