  "exclude_terms": [
    "hiring",
    "for hire",
    "paid gig"
  ],
  "groups": [
    {
      "title": "Engine and add-on releases",
      "match": {
        "feed_url_contains": [
          "github.com"
        ]
      }
    },
    {
      "title": "Official news and tutorials",
      "match": {
        "feed_url_contains": [
          "godotengine.org",
          "youtube.com",
          "catlikecoding.com",
          "redblobgames.com"
        ]
      }
    },
    {
      "title": "Community",
      "match": {
        "feed_url_contains": [
          "reddit.com",
          "forum.godotengine.org",
          "hnrss.org"
        ]
      }
    }
  ],
  "max_items_per_source": 4,
  "max_items": 40,
  "recency_half_life_days": 4,
  "trend_min_sources": 2,
  "cautions": [
    "Asset packs found through these sources keep their own licences; record the licence and credit line before using any asset."
  ],
  "polite": {
    "user_agent": "baltor-feed-reader/1.0 (+https://github.com/taylor-s-amarel/ai-video-pipeline)",
    "min_interval_s": 5,
    "max_polls_per_day": 24,
    "respect_retry_after": true,
    "conditional_get": true,
    "host_overrides": {
      "www.reddit.com": 60
    }
  },
  "outputs": {
    "markdown": "digests/godot-gamedev-weekly/{date}.md",
    "json": "digests/godot-gamedev-weekly/{date}.json"
  }
}
