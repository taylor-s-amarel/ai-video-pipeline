{
  "type": "title-style",
  "id": "title_minimal_serif_white",
  "name": "Minimal serif title",
  "version": 1,
  "house": false,
  "font": {
    "family": "Playfair Display",
    "weight": 800,
    "licence": "OFL-1.1",
    "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/playfairdisplay/PlayfairDisplay%5Bwght%5D.ttf",
    "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/playfairdisplay/OFL.txt",
    "specimen_url": "https://fonts.google.com/specimen/Playfair+Display",
    "size_px": 84,
    "min_size_px": 64,
    "case": "as-written",
    "avg_char_em": 0.45,
    "variable_axes": {
      "wght": [
        400.0,
        900.0
      ]
    }
  },
  "fill": "#F4FBEF",
  "stroke": {
    "color": "#06110A",
    "width_px": 0
  },
  "backing": {
    "type": "frosted-glass",
    "tint": "#0A1A0F",
    "opacity": 0.64,
    "blur_px": 30,
    "radius_px": 30,
    "padding_px": [
      24,
      40
    ],
    "feather_px": 24
  },
  "position": {
    "region": "upper-third",
    "center_y_fraction": 0.24,
    "over": "photo",
    "max_width_fraction": 0.86,
    "never_move_photo": true
  },
  "text": {
    "min_words": 2,
    "max_words": 7,
    "max_lines": 2,
    "max_chars_per_line": 22
  },
  "timing": {
    "first_frame": true,
    "hold_s": 2.4
  },
  "animation_in": "text_anim_blur_in_focus",
  "palette": "palette_forest_canopy",
  "contrast": {
    "title": {
      "basis": "panel-worst-case",
      "fg": "#F4FBEF",
      "bg": "#0A1A0F",
      "opacity": 0.64,
      "ratio": 5.13,
      "required": 3.0,
      "size_px": 64,
      "weight": 800,
      "level": "AAA"
    }
  },
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "reference_size": [
    1080,
    1920
  ],
  "use_when": [
    "Calm nature",
    "biography and quote shorts"
  ],
  "avoid_when": [
    "Hype edits"
  ],
  "shadow": {
    "color": "#06110A",
    "opacity": 0.5,
    "blur_px": 18,
    "offset_px": [
      0,
      4
    ]
  }
}
