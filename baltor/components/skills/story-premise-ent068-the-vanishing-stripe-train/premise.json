{
  "id": "ENT068",
  "title": "The Vanishing Stripe Train",
  "family": "fiction",
  "category": "perception and hidden objects",
  "premise": "A miniature detective wants to find which of three stationary striped boxes contains a toy train, but all look flat against striped scenery. They move a small viewing window sideways; parallax exposes the near box’s raised wheels, and the train rolls out only after being correctly identified.",
  "hook": "Nothing is moving. So why did that stripe shift?",
  "visible_action": "Viewing aperture slides; foreground stripe edges shift relative to the background; tiny wheels emerge; one box unfolds into a toy train.",
  "intended_takeaway_or_theme": "Changing viewpoint can reveal depth hidden in one view.",
  "gate": "Parallax must be physically consistent in the scene; avoid claims about diagnosing vision or universal human perception.",
  "evidence_class": "fictional_demonstration",
