{
  "type": "title-style",
  "id": "title_step_card_center",
  "name": "STEP N card",
  "version": 1,
  "house": false,
  "font": {
    "family": "Atkinson Hyperlegible",
    "weight": 700,
    "licence": "OFL-1.1",
    "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/atkinsonhyperlegible/AtkinsonHyperlegible-Bold.ttf",
    "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/atkinsonhyperlegible/OFL.txt",
    "specimen_url": "https://fonts.google.com/specimen/Atkinson+Hyperlegible",
    "size_px": 64,
    "min_size_px": 52,
    "case": "upper",
    "letter_spacing_em": 0.04,
    "avg_char_em": 0.581
  },
  "fill": "#F0E442",
  "stroke": {
    "color": "#000000",
    "width_px": 0
  },
  "backing": {
    "type": "frosted-glass",
    "tint": "#000000",
    "opacity": 0.66,
    "blur_px": 24,
    "radius_px": 24,
    "padding_px": [
      18,
      34
    ],
    "feather_px": 12
  },
  "position": {
    "region": "upper-third",
    "center_y_fraction": 0.28,
    "over": "photo",
    "max_width_fraction": 0.6,
    "never_move_photo": true
  },
  "text": {
    "template": "STEP {n}",
    "min_words": 2,
    "max_words": 2,
    "max_lines": 1,
    "max_chars_per_line": 15
  },
  "timing": {
    "first_frame": false,
    "hold_s": 2.4
  },
  "animation_in": "text_anim_springy_pop_overshoot",
  "palette": "palette_okabe_ito_safe",
  "contrast": {
    "title": {
      "basis": "panel-worst-case",
      "fg": "#F0E442",
      "bg": "#000000",
      "opacity": 0.66,
      "ratio": 5.49,
      "required": 3.0,
      "size_px": 52,
      "weight": 700,
      "level": "AAA"
    },
    "secondary": {
      "basis": "panel-worst-case",
      "fg": "#FFFFFF",
      "bg": "#000000",
      "opacity": 0.66,
      "ratio": 7.25,
      "required": 3.0,
      "size_px": 56,
      "weight": 700,
      "level": "AAA"
    }
  },
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "reference_size": [
    1080,
    1920
  ],
  "use_when": [
    "Tutorials and how-tos"
  ],
  "avoid_when": [
    "Fact lists (use FACT N)"
  ],
  "secondary": {
    "font": {
      "family": "Atkinson Hyperlegible",
      "weight": 700,
      "licence": "OFL-1.1",
      "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/atkinsonhyperlegible/AtkinsonHyperlegible-Bold.ttf",
      "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/atkinsonhyperlegible/OFL.txt",
      "specimen_url": "https://fonts.google.com/specimen/Atkinson+Hyperlegible",
      "size_px": 56,
      "case": "as-written",
      "avg_char_em": 0.471
    },
    "fill": "#FFFFFF",
    "gap_px": 10,
    "content": "the action in 2-5 words"
  }
}
