{
  "id": "ENT065",
  "title": "The Treasure Beneath the Caption",
  "family": "fiction",
  "category": "perception and hidden objects",
  "premise": "A treasure hunter searches a minimalist stage for a tiny key, but every explanatory caption lands directly over it. The hunter grabs the floating SEARCH HERE text and moves it aside, revealing the key; the final label reads MAYBE LESS TEXT and stays safely in the corner.",
  "hook": "The clue is being covered by the clue.",
  "visible_action": "Hunter circles stage; captions bounce onto the key; text is dragged upward; key glints; final label shrinks into a corner.",
  "intended_takeaway_or_theme": "Explanations can obstruct the thing they explain.",
  "gate": "Make the hidden key present from the opening frame; do not falsely imply a missing object was visible earlier.",
  "evidence_class": "fictional_demonstration",
