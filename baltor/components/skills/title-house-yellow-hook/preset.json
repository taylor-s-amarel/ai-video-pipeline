{
  "type": "title-style",
  "id": "title_house_yellow_hook",
  "name": "House yellow hook over the photo",
  "version": 1,
  "house": true,
  "font": {
    "family": "Montserrat",
    "weight": 900,
    "licence": "OFL-1.1",
    "file_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/montserrat/Montserrat%5Bwght%5D.ttf",
    "licence_url": "https://raw.githubusercontent.com/google/fonts/main/ofl/montserrat/OFL.txt",
    "specimen_url": "https://fonts.google.com/specimen/Montserrat",
    "size_px": 92,
    "min_size_px": 72,
    "case": "upper",
    "letter_spacing_em": 0.0,
    "avg_char_em": 0.648,
    "variable_axes": {
      "wght": [
        100.0,
        900.0
      ]
    }
  },
  "fill": "#FFD21F",
  "stroke": {
    "color": "#000000",
    "width_px": 3
  },
  "backing": {
    "type": "frosted-glass",
    "tint": "#0B1220",
    "opacity": 0.62,
    "blur_px": 28,
    "radius_px": 32,
    "padding_px": [
      26,
      40
    ],
    "feather_px": 24
  },
  "position": {
    "region": "upper-third",
    "center_y_fraction": 0.24,
    "over": "photo",
    "max_width_fraction": 0.88,
    "never_move_photo": true
  },
  "text": {
    "min_words": 2,
    "max_words": 7,
    "max_lines": 2,
    "max_chars_per_line": 14
  },
  "timing": {
    "first_frame": true,
    "hold_s": 2.4
  },
  "animation_in": "text_anim_settle_in",
  "palette": "palette_house_yellow_night",
  "contrast": {
    "title": {
      "basis": "panel-worst-case",
      "fg": "#FFD21F",
      "bg": "#0B1220",
      "opacity": 0.62,
      "ratio": 3.63,
      "required": 3.0,
      "size_px": 72,
      "weight": 900,
      "level": "AA"
    }
  },
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "reference_size": [
    1080,
    1920
  ],
  "use_when": [
    "The first frame of every house-style short"
  ],
  "avoid_when": [
    "Never move the photo or shrink it to make room; place the title over it"
  ],
  "shadow": {
    "color": "#000000",
    "opacity": 0.45,
    "blur_px": 12,
    "offset_px": [
      0,
      4
    ]
  },
  "notes": "Montserrat at weight 900 is a true bold, so the 3:1 large-bold contrast threshold applies. The hook is its own 2-7 word line, not a copy of the first caption. It is fully visible at 0.0 s; the settle-in animation only scales 1.04 -> 1.0."
}
