{
  "id": "EDU065",
  "title": "The Maybe Box Has a Date",
  "family": "learning",
  "category": "home organization",
  "premise": "A household wants to decide whether a few rarely used objects still belong in its storage, but repeated indecision keeps returning them to the main shelf. A dated review box records the question for a later deliberate decision.",
  "hook": "Can this decision wait somewhere that is not the whole shelf?",
  "visible_action": "Three uncertain objects enter a transparent box with a review date; the shelf clears while a calendar marker remains.",
  "intended_takeaway_or_theme": "A deferred decision benefits from a bounded place and an explicit review point.",
  "gate": "Do not imply permission to discard, donate, or sell items; ownership and sentiment remain with the user.",
  "evidence_class": "fictional_demonstration",
