{
  "type": "grid-system",
  "id": "grid_2x2_diagonal_emphasis",
  "name": "Diagonal emphasis",
  "version": 1,
  "rows": 2,
  "cols": 2,
  "gutter_px": 20,
  "margin_px": 0,
  "feather_px": 28,
  "corner_radius_px": 12,
  "cells": [
    {
      "source": "bg_layer_ocean_waves",
      "opacity": 0.5
    },
    {
      "source": "bg_layer_meadow_wind",
      "opacity": 0.25
    },
    {
      "source": "bg_layer_sunlit_water",
      "opacity": 0.25
    },
    {
      "source": "bg_layer_coastal_aerial",
      "opacity": 0.5
    }
  ],
  "placement": {
    "as": "background-layer",
    "blend": "screen",
    "layer_opacity": 0.98
  },
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "rects": [
    [
      0,
      0,
      530,
      950
    ],
    [
      550,
      0,
      530,
      950
    ],
    [
      0,
      970,
      530,
      950
    ],
    [
      550,
      970,
      530,
      950
    ]
  ],
  "render": {
    "filtergraph_file": "filtergraph.txt",
