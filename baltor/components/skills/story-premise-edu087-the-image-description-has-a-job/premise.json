{
  "id": "EDU087",
  "title": "The Image Description Has a Job",
  "family": "learning",
  "category": "accessibility/inclusion",
  "premise": "An author wants to describe a chart image, but a long list of decorative colors omits its relevant finding. Defining the image’s purpose leads to a concise description and an accessible route to the underlying data.",
  "hook": "What does the reader need this image to tell them?",
  "visible_action": "A decorative-description cloud contracts; chart purpose, finding, and data-access cards connect to the image.",
  "intended_takeaway_or_theme": "Text alternatives should reflect an image’s purpose in its actual context.",
  "gate": "Review the real image and relevant guidance; complex charts may need more than short alternative text.",
  "evidence_class": "requires_primary_source_review",
