{
  "type": "camera-move",
  "id": "camera_ken_burns_out_reveal",
  "name": "Ken Burns pull out to reveal",
  "version": 1,
  "kind": "ken-burns",
  "duration_s": 6,
  "zoom": {
    "from": 1.18,
    "to": 1.0
  },
  "center": {
    "from": [
      0.5,
      0.45
    ],
    "to": [
      0.5,
      0.5
    ]
  },
  "easing": "sine-in-out",
  "renderer": "zoompan",
  "prescale": 4,
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "intensity": "standard",
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  },
  "use_when": [
    "Reveal context after a detail",
    "Ending a section"
  ],
  "ffmpeg": {
    "filter": "scale=4320:7680:force_original_aspect_ratio=increase,crop=4320:7680,zoompan=z='1.18+(-0.18)*(0.5-0.5*cos(PI*((on/179))))':x='max(0,min(iw-iw/zoom,(0.5+(0)*(0.5-0.5*cos(PI*((on/179)))))*iw-iw/zoom/2))':y='max(0,min(ih-ih/zoom,(0.45+(0.05)*(0.5-0.5*cos(PI*((on/179)))))*ih-ih/zoom/2))':d=180:s=1080x1920:fps=30,setsar=1"
  }
}
