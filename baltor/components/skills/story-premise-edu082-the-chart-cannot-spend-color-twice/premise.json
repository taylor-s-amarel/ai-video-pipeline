{
  "id": "EDU082",
  "title": "The Chart Cannot Spend Color Twice",
  "family": "learning",
  "category": "accessibility/inclusion",
  "premise": "A reader wants to identify the two lines in a chart, but color is the only distinction. Adding direct labels and different stroke patterns makes the intended comparison available through more than one visual cue.",
  "hook": "If these colors look the same, what else tells them apart?",
  "visible_action": "Two colored chart lines shift to equal tones; labels and dash patterns appear while their data remain unchanged.",
  "intended_takeaway_or_theme": "Do not make color the sole carrier of essential information.",
  "gate": "Review applicable accessibility guidance; simulated color changes do not reproduce every person’s vision.",
  "evidence_class": "requires_primary_source_review",
