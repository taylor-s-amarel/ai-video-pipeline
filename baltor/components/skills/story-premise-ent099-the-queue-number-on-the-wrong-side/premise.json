  "id": "ENT099",
  "title": "The Queue Number on the Wrong Side",
  "family": "fiction",
  "category": "everyday microdramas",
  "premise": "A customer wants to know when their turn arrives but keeps watching the decorative back of a ticket. Nearby numbers advance until they rotate the ticket, discover theirs was just called, and politely show the attendant; the attendant flips a sample ticket above the counter for the next confused customer.",
  "hook": "My ticket seems very abstract.",
  "visible_action": "Display increments; ticket shows only a swirl; customer flips it to reveal a number; attendant mounts a two-sided sample.",
  "intended_takeaway_or_theme": "An error can reveal where the interface needs a clearer cue.",
  "gate": "Fictional service policy; do not imply a real business must honor a missed queue number.",
  "evidence_class": "fictional_demonstration",
