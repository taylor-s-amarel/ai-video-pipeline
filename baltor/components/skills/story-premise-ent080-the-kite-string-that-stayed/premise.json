{
  "id": "ENT080",
  "title": "The Kite String That Stayed",
  "family": "fiction",
  "category": "silent emotional stories",
  "premise": "Two friends want to keep flying a kite together, but one must leave before the breeze ends. They tie a tiny ribbon at the last shared grip point; the remaining friend flies the kite from below the ribbon and later wraps the spool with both names before putting it away.",
  "hook": "There is still a place for your hand.",
  "visible_action": "Two hands hold a spool; one releases; ribbon is tied; kite arcs gently; spool winds shut with ribbon visible on top.",
  "intended_takeaway_or_theme": "A small marker can preserve a shared moment.",
  "gate": "Use toy-scale open terrain and avoid real kite safety advice; separation is ordinary and not explained as a crisis.",
  "evidence_class": "fictional_demonstration",
