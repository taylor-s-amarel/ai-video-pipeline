  "id": "ENT007",
  "title": "The Stubborn Confetti Cannon",
  "family": "fiction",
  "category": "physical comedy",
  "premise": "A celebration planner wants one burst of confetti, but the hand-powered cannon only coughs out a single paper square each time. The planner arranges those squares into a giant celebratory mosaic; just as everyone applauds, the cannon releases a blank receipt labeled CONFETTI SOLD SEPARATELY.",
  "hook": "This celebration is arriving one square at a time.",
  "visible_action": "A crank turns; single squares flutter; a floor mosaic grows; the last pull unrolls a long receipt.",
  "intended_takeaway_or_theme": "Small outputs can still make something worth celebrating.",
  "gate": "Use a hand-cranked fictional paper dispenser, not a pressure-device construction tutorial.",
  "evidence_class": "fictional_demonstration",
