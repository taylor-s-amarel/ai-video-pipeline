  "id": "ENT064",
  "title": "The Shadow With an Extra Arm",
  "family": "fiction",
  "category": "perception and hidden objects",
  "premise": "A stagehand must find a supposed extra performer shown in a wall shadow, but the cast count is correct. A side view reveals that a coat-rack branch overlaps one actor’s shadow; moving the rack separates the silhouettes and gives the branch its own tiny bow.",
  "hook": "We hired three people. The wall hired four.",
  "visible_action": "Three actors pose; an extra shadow arm waves as a rack rolls; side view exposes overlap; rack moves away and shadows separate.",
  "intended_takeaway_or_theme": "One silhouette can combine several separate sources.",
  "gate": "Check actual lamp and object positions so the reveal explains the visible shadow without a continuity cheat.",
  "evidence_class": "fictional_demonstration",
