{
  "id": "ENT016",
  "title": "The Last Word Balloon",
  "family": "fiction",
  "category": "two-person rivalry",
  "premise": "Two debaters try to own the final speech bubble by stacking increasingly long replies. The bubbles become so heavy in this cartoon world that both speakers sag; they puncture all the bubbles with a tiny shared laugh, which floats away without either getting the last word.",
  "hook": "Fine. But my final word is larger.",
  "visible_action": "Text bubbles pile into towers; shoulders sink; one laugh bubble squeezes between them and pops the stacks.",
  "intended_takeaway_or_theme": "Ending an argument need not produce a winner.",
  "gate": "Words have fictional physical weight; avoid mocking any speech or language difference.",
  "evidence_class": "fictional_demonstration",
