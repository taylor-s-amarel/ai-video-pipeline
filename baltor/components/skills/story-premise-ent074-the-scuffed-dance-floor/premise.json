  "id": "ENT074",
  "title": "The Scuffed Dance Floor",
  "family": "fiction",
  "category": "silent emotional stories",
  "premise": "A dancer wants to perform on a spotless floor and keeps wiping away every rehearsal mark. When the cloth becomes worn out, they step back and notice the remaining marks trace the dance; they leave the path visible and perform along it for one quiet spectator.",
  "hook": "The floor remembers every attempt.",
  "visible_action": "Feet draw scuff arcs; cloth erases sections; an overhead shot reveals a winding route; dancer follows it into a final still pose.",
  "intended_takeaway_or_theme": "Traces of practice can belong in the finished work.",
  "gate": "Fictional expressive movement; not advice to dance on slippery, damaged, or unsafe flooring.",
  "evidence_class": "fictional_demonstration",
