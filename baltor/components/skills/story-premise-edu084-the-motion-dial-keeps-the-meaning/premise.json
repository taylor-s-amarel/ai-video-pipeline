{
  "id": "EDU084",
  "title": "The Motion Dial Keeps the Meaning",
  "family": "learning",
  "category": "accessibility/inclusion",
  "premise": "A viewer wants the result of an interface action, but a long sweeping animation is uncomfortable or distracting. A reduced-motion version preserves the state change with a quieter transition and equivalent information.",
  "hook": "Can this screen explain the change without the swoop?",
  "visible_action": "A panel sweep is replaced by an immediate state change and a small status marker in parallel previews.",
  "intended_takeaway_or_theme": "Motion can be optional while the underlying information and control remain available.",
  "gate": "Review reduced-motion guidance; no flashing, simulated symptoms, or claims about all motion sensitivities.",
  "evidence_class": "requires_primary_source_review",
