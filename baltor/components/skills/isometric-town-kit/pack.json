      "creator": "Kenney",
      "source_url": "https://kenney.nl/assets/isometric-tiles-city",
      "licence": "CC0-1.0",
      "licence_url": "https://kenney.nl/support",
      "attribution": "Isometric Tiles City by Kenney (kenney.nl), CC0",
      "attribution_required": false,
      "redistribution": "allowed",
      "commercial_use": "allowed",
      "format": "zip",
      "intended_use": [
        "roads, buildings and parks"
      ],
      "fetch": {
        "method": "manual-page",
        "status": "to-fetch"
      },
      "import_hints": {
        "godot": {
          "importer": "texture",
          "preset": "smooth-2d"
        }
      },
      "verification": {
        "on": "2026-10-10",
        "how": "search-result"
      }
    },
