{
  "id": "ENT010",
  "title": "The Overenthusiastic Echo",
  "family": "fiction",
  "category": "physical comedy",
  "premise": "A performer wants to deliver a short greeting in a fantasy echo hall, but each echo adds an extra flourish until the hall is performing an entire musical introduction. The performer switches to a written HELLO card; the echo produces a smaller written HELLO and finally behaves.",
  "hook": "Hello. HELLO! HELLOOO! We have a problem.",
  "visible_action": "Speech bubbles bounce along walls, grow decorative arms and musical notes, then shrink into two matching silent cards.",
  "intended_takeaway_or_theme": "Change the channel when the old one keeps amplifying confusion.",
  "gate": "The echo is magical and can read; do not use this as a model of real sound reflection.",
  "evidence_class": "fictional_demonstration",
