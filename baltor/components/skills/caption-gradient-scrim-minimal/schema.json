{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/caption-style-preset-schema",
  "title": "Caption style preset",
  "description": "One synced caption line style for vertical video: font, fill, outline, backing panel, layout inside a platform safe area, keyword emphasis, timing and measured WCAG contrast.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "name",
    "version",
    "font",
    "fill",
    "backing",
    "layout",
    "emphasis",
    "timing",
    "contrast",
    "target"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/identity"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "string"
    },
    "variant": {
      "type": "object",
      "description": "Present on variants: base identity and what changed."
    },
    "type": {
      "const": "caption-style"
    },
    "house": {
      "type": "boolean"
    },
    "font": {
      "$ref": "#/$defs/font"
    },
    "fill": {
      "$ref": "#/$defs/hex"
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "width_px"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/hex"
        },
        "width_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        }
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/hex"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "blur_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 80
        },
        "offset_px": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "backing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "frosted-glass",
            "solid",
            "pill",
            "scrim",
            "sticker",
            "none"
          ]
        },
        "tint": {
          "$ref": "#/$defs/hex"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "blur_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "radius_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 999
        },
        "padding_px": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "feather_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "rotation_deg": {
          "type": "number",
          "minimum": -15,
          "maximum": 15
        },
        "full_width": {
          "type": "boolean"
        },
        "shape": {
          "enum": [
            "rounded-rect",
            "starburst"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "frosted-glass"
              }
            }
          },
          "then": {
            "required": [
              "tint",
              "opacity",
              "blur_px"
            ],
            "properties": {
              "blur_px": {
                "minimum": 8
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "solid",
                  "pill",
                  "scrim",
                  "sticker"
                ]
              }
            }
          },
          "then": {
            "required": [
              "tint",
              "opacity"
            ]
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center_y_fraction",
        "max_width_fraction",
        "max_lines",
        "max_words",
        "max_chars",
        "align"
      ],
      "properties": {
        "center_y_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_width_fraction": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_chars": {
          "type": "integer",
          "minimum": 4,
          "maximum": 80
        },
        "align": {
          "enum": [
            "center",
            "left",
            "right"
          ]
        }
      }
    },
    "emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "keyword-pop",
            "color",
            "box-current-word",
            "box-keyword",
            "underline",
            "glow",
            "none"
          ]
        },
        "color": {
          "$ref": "#/$defs/hex"
        },
        "text_color": {
          "$ref": "#/$defs/hex"
        },
        "box_opacity": {
          "$ref": "#/$defs/opacity"
        },
        "scale_peak": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.5
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "easing": {
          "$ref": "#/$defs/easing"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sync_tolerance_ms"
      ],
      "properties": {
        "sync_tolerance_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "min_on_screen_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_on_screen_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "animation_in": {
      "$ref": "#/$defs/identity"
    },
    "keyword_animation": {
      "$ref": "#/$defs/identity"
    },
    "palette": {
      "$ref": "#/$defs/identity"
    },
    "contrast": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/contrast"
      }
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "reference_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 256
      },
      "minItems": 2,
      "maxItems": 2
    },
    "use_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoid_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.98,
      "description": "Layer or panel opacity. House rule: nothing above 0.98."
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "easing": {
      "oneOf": [
        {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out",
            "sine-in-out",
            "ease-out-back",
            "ease-out-elastic",
            "step"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "cubic-bezier(x1, y1, x2, y2)"
        }
      ]
    },
    "blend": {
      "enum": [
        "add",
        "color-dodge",
        "darken",
        "difference",
        "hard-light",
        "lighten",
        "multiply",
        "normal",
        "overlay",
        "screen",
        "soft-light"
      ]
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "weight",
        "licence",
        "file_url"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 2
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        },
        "size_px": {
          "type": "number",
          "minimum": 8,
          "maximum": 400
        },
        "min_size_px": {
          "type": "number",
          "minimum": 8,
          "maximum": 400
        },
        "case": {
          "enum": [
            "as-written",
            "upper",
            "lower",
            "title"
          ]
        },
        "letter_spacing_em": {
          "type": "number",
          "minimum": -0.1,
          "maximum": 0.5
        },
        "licence": {
          "enum": [
            "OFL-1.1",
            "Apache-2.0"
          ]
        },
        "file_url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/google/fonts/main/"
        },
        "licence_url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/google/fonts/main/"
        },
        "specimen_url": {
          "type": "string",
          "pattern": "^https://fonts\\.google\\.com/specimen/"
        },
        "avg_char_em": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1.2
        },
        "variable_axes": {
          "type": "object"
        }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "fg",
        "bg",
        "ratio",
        "required"
      ],
      "properties": {
        "basis": {
          "enum": [
            "panel-worst-case",
            "stroke",
            "solid"
          ],
          "description": "panel-worst-case: fg over a bg-tinted panel at `opacity` over any video (worst of black/white beneath)."
        },
        "fg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.98
        },
        "ratio": {
          "type": "number",
          "minimum": 3.0,
          "maximum": 21.0
        },
        "required": {
          "enum": [
            3.0,
            4.5
          ]
        },
        "size_px": {
          "type": "number"
        },
        "weight": {
          "type": "integer"
        },
        "level": {
          "enum": [
            "AA",
            "AAA"
          ]
        },
        "stroke_px": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": 4.5
              }
            }
          },
          "then": {
            "properties": {
              "ratio": {
                "minimum": 4.5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "panel-worst-case"
              }
            }
          },
          "then": {
            "required": [
              "opacity"
            ]
          }
        }
      ]
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "aspect",
        "width",
        "height",
        "safe_margins"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "generic",
            "youtube-shorts",
            "instagram-reels",
            "tiktok",
            "instagram-feed",
            "youtube"
          ]
        },
        "aspect": {
          "enum": [
            "9:16",
            "4:5",
            "1:1",
            "16:9"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096
        },
        "safe_margins": {
          "$ref": "#/$defs/margins"
        },
        "margins_basis": {
          "type": "string"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "static",
            "loop",
            "drift",
            "scroll",
            "pan",
            "zoom",
            "rotate",
            "parallax",
            "rise",
            "fall",
            "sway",
            "pulse",
            "follow",
            "keyframed",
            "ken-burns",
            "punch-in"
          ]
        },
        "period_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "house": {
            "const": true
          }
        },
        "required": [
          "house"
        ]
      },
      "then": {
        "properties": {
          "backing": {
            "properties": {
              "type": {
                "const": "frosted-glass"
              },
              "opacity": {
                "minimum": 0.55,
                "maximum": 0.75
              }
            }
          },
          "layout": {
            "properties": {
              "max_lines": {
                "const": 1
              },
              "max_words": {
                "maximum": 7
              }
            }
          },
          "timing": {
            "properties": {
              "sync_tolerance_ms": {
                "maximum": 150
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backing": {
            "properties": {
              "type": {
                "const": "none"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "stroke"
        ],
        "properties": {
          "stroke": {
            "properties": {
              "width_px": {
                "minimum": 4
              }
            }
          }
        }
      }
    }
  ]
}
