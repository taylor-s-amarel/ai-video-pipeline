{
  "id": "ENT038",
  "title": "The Sock-Drawer Northern Lights",
  "family": "fiction",
  "category": "miniature adventure",
  "premise": "A tiny explorer seeks a colorful glow at the back of a sock drawer, but every opening floods the scene with harsh light and rearranges the terrain. They mark a path with paired socks, wait for the drawer to settle, and find an original glow-in-the-dark star patch casting the mysterious colors.",
  "hook": "The sky changes every time the drawer opens.",
  "visible_action": "Drawer slides; sock hills tumble gently; paired-sock markers align; a stitched star patch reveals its glow in the dark.",
  "intended_takeaway_or_theme": "A mystery can have a small, local source.",
  "gate": "Glow colors and scale are stylized; avoid implying that ordinary fabric produces light.",
  "evidence_class": "fictional_demonstration",
