  "id": "ENT011",
  "title": "The Trophy Nobody Can Lift",
  "family": "fiction",
  "category": "two-person rivalry",
  "premise": "Two rivals compete to decorate a shared trophy, adding heavier ornaments after every round. When neither can carry the result onto the podium, they remove one ornament at a time until only a simple cup remains, then argue playfully over who gets credit for the final subtraction.",
  "hook": "Winning has become a lifting problem.",
  "visible_action": "Ornaments stack; trophy base sinks into a soft pedestal; rivals strain, remove matching pieces, and hold the tiny cup together.",
  "intended_takeaway_or_theme": "Competition can make the original purpose disappear.",
  "gate": "Use toy-scale weights and exaggerated deformation; do not demonstrate unsafe lifting.",
  "evidence_class": "fictional_demonstration",
