{
  "id": "EDU088",
  "title": "The Timer Erases an Unfinished Form",
  "family": "learning",
  "category": "accessibility/inclusion",
  "premise": "A user wants to finish a form at their own pace, but an unexpected timeout clears entered information. A reviewed design exposes timing, offers appropriate continuation, and preserves progress where permitted.",
  "hook": "Why did the form disappear before the answer was ready?",
  "visible_action": "A hidden timer becomes visible; warning and continuation states appear, and entered blocks remain in a protected draft lane.",
  "intended_takeaway_or_theme": "Time limits should be considered explicitly in accessible interaction design.",
  "gate": "Review timing exceptions, privacy, and security constraints; no blanket requirement to retain sensitive entries.",
  "evidence_class": "requires_primary_source_review",
