  "id": "ENT059",
  "title": "The Nine-Tile Mosaic",
  "family": "fiction",
  "category": "mechanical puzzles",
  "premise": "An artist must fill a 3-by-3 board with nine tiles so each row shows one circle, one square, and one triangle. The first attempt repeats a circle; they rearrange rows as circle-square-triangle, square-triangle-circle, triangle-circle-square, producing rows and columns with one of each.",
  "hook": "Every row wants all three shapes.",
  "visible_action": "Tiles slide into nine cells; duplicate symbols flash; rows rotate into a Latin-square pattern; matching columns illuminate.",
  "intended_takeaway_or_theme": "Check constraints in both directions when the puzzle promises both.",
  "gate": "Verified 3×3 Latin square; each row and column contains C,S,T exactly once. If only rows are required, the displayed answer is valid but not unique.",
