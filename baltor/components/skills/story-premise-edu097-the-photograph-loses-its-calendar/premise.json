{
  "id": "EDU097",
  "title": "The Photograph Loses Its Calendar",
  "family": "learning",
  "category": "consumer digital literacy",
  "premise": "A viewer wants to judge a dramatic claim, but a real-looking image arrives without its original date or context. The story follows source tracing until the image’s earlier setting changes the interpretation.",
  "hook": "What if this picture is real but the caption is wrong?",
  "visible_action": "A photo card detaches from a dramatic caption; source and date cards reattach as a timeline reveals its earlier context.",
  "intended_takeaway_or_theme": "Authentic media can still be presented with misleading context.",
  "gate": "Use an invented event and owned illustration; do not falsely accuse an actual source or treat metadata alone as proof.",
  "evidence_class": "fictional_demonstration",
