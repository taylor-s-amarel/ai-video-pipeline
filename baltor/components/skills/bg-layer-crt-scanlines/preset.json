{
  "type": "background-layer",
  "id": "bg_layer_crt_scanlines",
  "name": "CRT scanlines",
  "version": 1,
  "category": "overlay",
  "role": "overlay",
  "look": "Fine horizontal scanlines with a bright band rolling down the screen.",
  "render": {
    "method": "ffmpeg-lavfi",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "loop_period_s": 8,
    "filtergraph_file": "filtergraph.txt",
    "tested_with": "FFmpeg 6.1.1",
    "colour_stops": [
      [
        0,
        "#031A12"
      ],
      [
        80,
        "#0B4D33"
      ],
      [
        170,
        "#1FA968"
      ],
      [
        255,
        "#B6FFD9"
      ]
    ]
  },
  "default_opacity": 0.18,
  "default_blend": "overlay",
  "motion": {
    "type": "scroll",
    "period_s": 8
  },
  "recolor": "ramp",
  "use_when": [
    "Retro gaming and terminal looks",
    "over pixel art"
  ],
  "target": {
    "id": "generic_9x16",
    "label": "Vertical 9:16 (generic)",
    "platform": "generic",
    "aspect": "9:16",
    "width": 1080,
    "height": 1920,
    "safe_margins": {
      "top": 0.08,
      "bottom": 0.2,
      "left": 0.06,
      "right": 0.06
    },
    "margins_basis": "House margins (not a platform specification). Chosen to keep text clear of typical top bars, right-hand action buttons and bottom description areas. Not verified against platform documentation on 2026-10-10; preview on the platform before publishing."
  }
}
