{
  "id": "ENT003",
  "title": "The Invisible Bench Audition",
  "family": "fiction",
  "category": "physical comedy",
  "premise": "A mime wants to demonstrate a perfect imaginary bench, but each audience member imagines a different height and sits out of sync. The mime draws a visible baseline in chalk, everyone aligns their poses, and a passing janitor politely sweeps the entire imaginary bench away.",
  "hook": "Please sit on the bench that is not there.",
  "visible_action": "Figures hover at mismatched heights; chalk line extends; everyone settles together; broom passes and the seated row tips gently onto cushions.",
  "intended_takeaway_or_theme": "Shared reference points make coordination easier.",
  "gate": "Keep the final fall stylized and cushioned; the invisible bench is explicitly a mime gag.",
  "evidence_class": "fictional_demonstration",
