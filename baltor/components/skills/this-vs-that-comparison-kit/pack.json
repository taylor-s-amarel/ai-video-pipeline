{
  "spec": "baltor.media-pack/v1",
  "pack_id": "this-vs-that-comparison-kit",
  "title": "This-vs-that comparison kit",
  "purpose": "Use when making split-screen 'this vs that' or ranking shorts. Lists CC0 Kenney props, a game-icons versus icon (CC BY 3.0 credit), MIT check/cross icons, OFL heavy title fonts, Kenney Casino Audio for reveals, Kenney UI panels and Twemoji reaction stickers (CC-BY credit).",
  "status": "manifest-only",
  "created": "2026-10-10",
  "verified_on": "2026-10-10",
  "targets": [
    "ffmpeg-video",
    "godot-4"
  ],
  "frame": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "licence_policy": {
    "allow_non_commercial": false,
    "allow_share_alike": false,
    "require_redistributable": false,
    "notes": "Monetised-video policy: no NC or ND assets; credit every CC-BY asset in the description."
  },
  "credits_file": "CREDITS.md",
  "notes": [
    "Manifest only: no media files are included. Fetch direct assets with the media_pack_fetcher module; open manual-page sources in a browser and record sha256 after download."
