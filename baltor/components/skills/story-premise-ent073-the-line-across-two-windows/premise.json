{
  "id": "ENT073",
  "title": "The Line Across Two Windows",
  "family": "fiction",
  "category": "silent emotional stories",
  "premise": "Two neighbors want company without interrupting each other’s quiet evenings. One draws a small hill on a window, the other continues the line on theirs, and over several nights the separate drawings become one landscape that both sit beside with their lights on.",
  "hook": "One line reaches the next window.",
  "visible_action": "A curved line appears on one pane; another extends it; mountains, a river, and two tiny houses gradually connect across the building gap.",
  "intended_takeaway_or_theme": "Connection can be gentle and leave room for quiet.",
  "gate": "Use fictional neighbors and transparent removable drawing materials; no implied obligation to socialize.",
  "evidence_class": "fictional_demonstration",
