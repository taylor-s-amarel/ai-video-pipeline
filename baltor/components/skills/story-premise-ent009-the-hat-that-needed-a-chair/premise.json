{
  "id": "ENT009",
  "title": "The Hat That Needed a Chair",
  "family": "fiction",
  "category": "physical comedy",
  "premise": "A figure wants to wear an enormous formal hat, but its towering decorations keep bending the wearer into increasingly strange poses. The figure seats the hat on its own stool and wears only the detachable band, while guests line up to compliment the hat as if it were a person.",
  "hook": "The hat has requested its own seat.",
  "visible_action": "Hat tower sways; wearer folds sideways; decorations rotate; hat settles on a stool; a tiny band stays on the head.",
  "intended_takeaway_or_theme": "A decorative requirement does not have to control the whole person.",
  "gate": "Original fictional characters and rules; do not present the gag as an empirical claim.",
  "evidence_class": "fictional_demonstration",
