{
  "id": "ENT108",
  "title": "The Alien Who Bought a Reflection",
  "family": "fiction",
  "category": "fantasy and science fiction",
  "premise": "An alien visitor wants to take home a shiny moon seen in a pond, but scooping the water keeps breaking the reflected image. A local artist paints a small original moon card; the alien trades a star-shaped pebble for it and holds the card still while the real reflection ripples goodbye.",
  "hook": "I would like one moon, to go.",
  "visible_action": "Scoop enters water; moon image fragments; alien looks puzzled; artist paints a card; card and pebble exchange; pond reflection reforms.",
  "intended_takeaway_or_theme": "A representation can travel even when its source cannot.",
  "gate": "Original alien design; stylized reflections should remain visually consistent, with no claim that the moon is physically in the pond.",
  "evidence_class": "fictional_demonstration",
