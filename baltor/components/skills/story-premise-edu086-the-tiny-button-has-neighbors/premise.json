{
  "id": "EDU086",
  "title": "The Tiny Button Has Neighbors",
  "family": "learning",
  "category": "accessibility/inclusion",
  "premise": "A person wants to select one control, but tightly packed small targets make unintended neighbors easy to hit in a toy interface. A revised layout enlarges and separates targets without changing their functions.",
  "hook": "Which target did this tap actually hit?",
  "visible_action": "A pointer landing area overlaps three small controls; targets expand and spacing opens in the comparison layout.",
  "intended_takeaway_or_theme": "Interactive target size and spacing affect how forgiving a control layout is.",
  "gate": "Review platform-specific guidance; do not invent universal pixel sizes or simulate a disability.",
