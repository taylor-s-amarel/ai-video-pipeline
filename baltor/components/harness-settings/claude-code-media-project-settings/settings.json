{
  "permissions": {
    "allow": [
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(python3 baltor/tools/baltor_catalog.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/client_secret.json)",
      "Read(./.youtube_credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .baltor/hooks/block-staged-secrets/hook.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
