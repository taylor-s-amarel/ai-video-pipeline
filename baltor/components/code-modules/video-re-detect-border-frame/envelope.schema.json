{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/video-re-detection-envelope",
  "title": "Video detection result envelope",
  "description": "Every video_re detector returns this envelope. 'payload' holds the detector-specific result described by that detector's own contract schema (video_re_contract_<property>). Missing measurements are null with an error entry; nothing is invented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "detector", "version", "source", "status", "results", "payload", "errors"],
  "properties": {
    "spec": { "const": "baltor.video-detection/v1" },
    "detector": { "type": "string", "pattern": "^video_re_(detect|classify|similarity)_[a-z0-9_]+$" },
    "version": { "type": "string" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["reference"],
      "properties": {
        "reference": { "type": "string" },
        "compare_to": { "type": "string" },
        "duration_s": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "minimum": 0 }
      }
    },
    "status": { "enum": ["ok", "partial", "unavailable", "error"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "confidence"],
        "properties": {
          "t_start_s": { "type": "number", "minimum": 0 },
          "t_end_s": { "type": "number", "minimum": 0 },
          "label": { "type": "string" },
          "value": {},
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "x, y, w, h in pixels of the analysed frame" },
          "evidence": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "payload": { "type": ["object", "null"] },
    "params": { "type": "object", "description": "thresholds and settings used, so results are reproducible" },
    "tools": { "type": "object", "additionalProperties": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
