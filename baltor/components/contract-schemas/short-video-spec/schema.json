{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/short-video-spec",
  "title": "Short video spec",
  "description": "Everything a renderer needs for one vertical short: hook title, scenes, layers, captions, narration and music credits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title_hook",
    "duration_s",
    "format",
    "scenes",
    "narration",
    "music"
  ],
  "properties": {
    "title_hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "color",
        "position"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 48
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "position": {
          "enum": [
            "upper-third-over-photo",
            "center-over-photo"
          ]
        },
        "backing": {
          "enum": [
            "frosted-glass",
            "none"
          ],
          "default": "frosted-glass"
        },
        "hold_s": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 4
        }
      }
    },
    "duration_s": {
      "type": "number",
      "minimum": 60,
      "maximum": 180
    },
    "format": {
      "enum": [
        "1080x1920",
        "1080x1350",
        "1920x1080"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_s",
          "end_s",
          "layers"
        ],
        "properties": {
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "string",
            "pattern": "^(FACT|TIP|STEP) [0-9]{1,2}$"
          },
          "key_number": {
            "type": "string",
            "maxLength": 24
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source",
                "opacity"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "background-video",
                    "background-image",
                    "grid-2x2",
                    "photo",
                    "particles",
                    "light",
                    "texture",
                    "overlay",
                    "text"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.98
                },
                "blend": {
                  "enum": [
                    "normal",
                    "screen",
                    "multiply",
                    "overlay",
                    "soft-light",
                    "add"
                  ]
                },
                "feather_px": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 200
                },
                "motion": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_s",
          "end_s",
          "text"
        ],
        "properties": {
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 60
          },
          "pop_word": {
            "type": "string"
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "voice"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "words_per_minute": {
          "type": "number",
          "minimum": 120,
          "maximum": 175
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "licence"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "type": "string"
        },
        "gain_db": {
          "type": "number",
          "maximum": -6
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
