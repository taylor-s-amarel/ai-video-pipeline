{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/source-digest-report",
  "title": "Source digest report",
  "description": "Output of a digest or trend-scan run: selected items grouped into sections, rising terms each backed by cited URLs from at least two feeds, and feeds that failed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "watchlist_id",
    "generated_at",
    "window",
    "counts",
    "sections",
    "trends",
    "errors"
  ],
  "properties": {
    "spec": {
      "const": "baltor.source-digest/v1"
    },
    "watchlist_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "since",
        "until"
      ],
      "properties": {
        "since": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_in",
        "items_in_window",
        "items_selected",
        "sources"
      ],
      "properties": {
        "items_in": {
          "type": "integer",
          "minimum": 0
        },
        "items_in_window": {
          "type": "integer",
          "minimum": 0
        },
        "items_selected": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "items"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url",
                "source",
                "published",
                "score",
                "matched"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "source": {
                  "type": "string"
                },
                "published": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "score": {
                  "type": "number",
                  "minimum": 0
                },
                "matched": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "also_in": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "why_it_matters": {
                  "type": "string",
                  "description": "Optional one-line note written by the agent after opening the source."
                },
                "checked": {
                  "type": "boolean",
                  "description": "true only when the agent opened the source and confirmed the claim."
                }
              }
            }
          }
        }
      }
    },
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "count",
          "previous_count",
          "change",
          "sources",
          "citations"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "previous_count": {
            "type": "integer",
            "minimum": 0
          },
          "change": {
            "type": "number"
          },
          "sources": {
            "type": "integer",
            "minimum": 2
          },
          "citations": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feed_url",
          "error"
        ],
        "properties": {
          "feed_url": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "retry_after_s": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
