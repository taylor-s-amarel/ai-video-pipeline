{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taylor-s-amarel/ai-video-pipeline/baltor/contract-schemas/treatment-address",
  "title": "Creative-catalogue treatment address",
  "description": "One of the 2,400 addressable candidate treatments: R-{story_id}-{format_id}-{approach_id}, with the intro and motion the story's treatment group assigns. The oneOf branches encode the four treatment groups exactly, so a format or approach a group does not use fails. That the address string agrees with its parts is checked by the treatment_address_resolver module. A compatible combination is still not a screenplay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "address",
    "story_id",
    "format_id",
    "approach_id",
    "intro_id",
    "motion_id",
    "status"
  ],
  "properties": {
    "address": {
      "type": "string",
      "pattern": "^R-(EDU|ENT)[0-9]{3}-F[0-9]{2}-A0[1-4]$"
    },
    "story_id": {
      "type": "string",
      "pattern": "^(EDU|ENT)[0-9]{3}$"
    },
    "format_id": {
      "type": "string",
      "pattern": "^F[0-9]{2}$"
    },
    "approach_id": {
      "enum": [
        "A01",
        "A02",
        "A03",
        "A04"
      ]
    },
    "intro_id": {
      "type": "string",
      "pattern": "^I[0-3][0-9]$"
    },
    "motion_id": {
      "type": "string",
      "pattern": "^M[0-3][0-9]$"
    },
    "treatment_group": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "status": {
      "enum": [
        "addressable-candidate",
        "selected",
        "scripted",
        "storyboarded",
        "rendered",
        "rejected"
      ],
      "description": "Every catalogue address starts as addressable-candidate."
    },
    "status_evidence": {
      "type": "string",
      "minLength": 10
    }
  },
